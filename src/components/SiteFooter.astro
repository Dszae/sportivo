---
import { categories } from '../lib/sportivo';

const currentYear = new Date().getFullYear();

const socials = [
  { href: 'https://www.dipeshsapkota7.com.np/', label: 'Website', path: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM2 12h20M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10z' },
  { href: 'https://github.com/dszae', label: 'GitHub', path: 'M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21' },
  { href: 'https://www.linkedin.com/in/dipeshsapkota7/', label: 'LinkedIn', path: 'M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z' },
  { href: 'https://facebook.com/dsz.ae', label: 'Facebook', path: 'M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z' },
];
---
<footer class="mt-24 border-t border-line bg-ink-950 text-fg-2" itemscope itemtype="https://schema.org/WPFooter">
  <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-12 sm:grid-cols-2 lg:grid-cols-4">
      <div class="space-y-4">
        <a href="/" class="inline-flex items-center gap-2" aria-label="Sportivo home">
          <span class="h-2 w-2 rounded-full bg-lime" aria-hidden="true"></span>
          <span class="text-[17px] font-semibold leading-none text-fg">Sportivo</span>
        </a>
        <p class="max-w-xs text-sm leading-6 text-fg-2">
          Fixtures, live scores and streams for football, cricket and basketball, with every kickoff in Nepal Standard Time.
        </p>
        <a href="/about-dipesh-sapkota/" class="inline-flex items-center gap-2 text-sm text-fg-2 transition-colors duration-fast ease-out hover:text-fg">
          <img src="/dipesh-sapkota-profile.webp" alt="" width="20" height="20" class="h-5 w-5 rounded-full object-cover" />
          <span>Made by Dipesh Sapkota</span>
        </a>
      </div>

      <div>
        <p class="eyebrow">Fixtures</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/" class="transition-colors duration-fast ease-out hover:text-fg">All sports</a></li>
          <li><a href="/npl/" class="transition-colors duration-fast ease-out hover:text-fg">NPL 2026</a></li>
          {categories.map((cat) => (
            <li><a href={`/${cat}/`} class="capitalize transition-colors duration-fast ease-out hover:text-fg">{cat}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <p class="eyebrow">Site</p>
        <ul class="mt-4 space-y-2 text-sm">
          <li><a href="/dashboard/" class="transition-colors duration-fast ease-out hover:text-fg">Watchlist</a></li>
          <li><a href="/about-dipesh-sapkota/" class="transition-colors duration-fast ease-out hover:text-fg">About</a></li>
          <li><a href="/api-docs/" class="transition-colors duration-fast ease-out hover:text-fg">Developer API</a></li>
          <li><a href="/privacy/" class="transition-colors duration-fast ease-out hover:text-fg">Privacy</a></li>
          <li><a href="/sitemap.xml" target="_blank" class="transition-colors duration-fast ease-out hover:text-fg">Sitemap</a></li>
          <li><a href="/llms.txt" target="_blank" class="transition-colors duration-fast ease-out hover:text-fg">llms.txt</a></li>
        </ul>
      </div>

      <div>
        <p class="eyebrow">Elsewhere</p>
        <nav aria-label="Social links" class="mt-4 flex items-center gap-2">
          {socials.map((s) => (
            <a href={s.href} rel="me author external" target="_blank" title={s.label} aria-label={s.label} class="icon-btn">
              <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={s.path} />
              </svg>
            </a>
          ))}
        </nav>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-3 border-t border-line pt-6 text-xs text-fg-3 sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {currentYear} Sportivo</p>
      <p class="clock">Nepal Standard Time, UTC+5:45</p>
    </div>
  </div>
</footer>
