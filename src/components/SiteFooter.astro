---
import { categories } from '../lib/sportivo';

const currentYear = new Date().getFullYear();
---
<footer class="site-footer mt-24 border-t border-white/10 bg-[#090d0c] text-slate-400" itemscope itemtype="https://schema.org/WPFooter">
  <div class="mx-auto max-w-7xl px-6 py-14">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-4">
      <!-- Col 1: Brand & Creator -->
      <div class="space-y-4 md:col-span-1">
        <a href="/" class="group flex flex-col" aria-label="Sportivo home">
          <span class="flex items-center gap-2.5">
            <span class="relative flex h-2.5 w-2.5">
              <span class="site-logo-dot relative inline-flex h-2.5 w-2.5 rounded-full"></span>
            </span>
            <span class="text-xl font-black tracking-tight text-white">Sportivo<span class="site-accent">.</span></span>
          </span>
          <span class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mt-1">Live sports fixtures desk</span>
        </a>
        <p class="text-xs leading-relaxed text-slate-400">
          Independent sports schedule platform engineered by <strong class="text-slate-200">Dipesh Sapkota</strong> in Nepal. Real-time scores, NST kickoff times, and upstream streams.
        </p>
        <div class="pt-1">
          <a
            href="/about-dipesh-sapkota/"
            class="inline-flex items-center gap-2 rounded-full border border-[#c9f36b]/30 bg-[#c9f36b]/10 px-3 py-1.5 text-xs font-bold text-[#c9f36b] hover:bg-[#c9f36b]/20 hover:text-white transition"
          >
            <img src="/dipesh-sapkota-profile.webp" alt="Dipesh Sapkota" width="18" height="18" class="h-4.5 w-4.5 rounded-full object-cover border border-[#c9f36b]" />
            <span>Meet Dipesh Sapkota &rarr;</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Sports Sitelinks -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#e5b94f]">Fixtures & Hubs</p>
        <ul class="mt-4 space-y-2.5 text-xs">
          <li>
            <a href="/" class="hover:text-[#c9f36b] transition">Live Fixtures Desk (Home)</a>
          </li>
          {categories.map((cat) => (
            <li>
              <a href={`/${cat}/`} class="capitalize hover:text-[#c9f36b] transition">
                {cat} fixtures & streams
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: About & Developer -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#e5b94f]">About & Dev</p>
        <ul class="mt-4 space-y-2.5 text-xs">
          <li>
            <a href="/about-dipesh-sapkota/" class="font-bold text-slate-200 hover:text-[#c9f36b] transition">
              About Dipesh Sapkota (Creator)
            </a>
          </li>
          <li>
            <a href="/api-docs/" class="hover:text-[#c9f36b] transition">
              Public Developer API
            </a>
          </li>
          <li>
            <a href="/sitemap.xml" target="_blank" class="hover:text-[#c9f36b] transition">
              XML Sitemap (170+ URLs)
            </a>
          </li>
          <li>
            <a href="/llms.txt" target="_blank" class="hover:text-[#c9f36b] transition">
              LLMs Machine Summary
            </a>
          </li>
          <li>
            <a href="/robots.txt" target="_blank" class="hover:text-[#c9f36b] transition">
              Robots.txt Directive
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Verified Author Links -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#e5b94f]">Dipesh Sapkota</p>
        <p class="mt-2 text-xs text-slate-400">Engineering student & software developer from Nepal.</p>
        <nav aria-label="Dipesh Sapkota verified links" class="mt-4 flex flex-col gap-2 text-xs font-semibold">
          <a href="https://www.dipeshsapkota7.com.np/" rel="me author external" target="_blank" class="text-[#c9f36b] hover:underline">
            Personal Portfolio ↗
          </a>
          <a href="https://github.com/dszae" rel="me author external" target="_blank" class="hover:text-white transition">
            GitHub (@dszae) ↗
          </a>
          <a href="https://linkedin.com/in/dszae" rel="me author external" target="_blank" class="hover:text-white transition">
            LinkedIn Profile ↗
          </a>
          <a href="https://facebook.com/dsz.ae" rel="me author external" target="_blank" class="hover:text-white transition">
            Facebook Profile ↗
          </a>
        </nav>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-8 text-[11px] text-slate-500 sm:flex-row">
      <p>
        &copy; {currentYear} <strong class="text-slate-400">Dipesh Sapkota</strong>. Sportivo is an independent sports project.
      </p>
      <p class="flex items-center gap-3">
        <span>Nepal Standard Time (UTC+5:45)</span>
        <span>&bull;</span>
        <span>Engineered in Nepal</span>
      </p>
    </div>
  </div>
</footer>
