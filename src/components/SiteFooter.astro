---
import { categories } from '../lib/sportivo';

const currentYear = new Date().getFullYear();
---
<footer class="site-footer mt-24 border-t border-white/10 bg-[#090d0c] text-slate-400" itemscope itemtype="https://schema.org/WPFooter">
  <div class="mx-auto max-w-7xl px-6 py-14">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 md:grid-cols-4">
      <!-- Col 1: Brand & Creator -->
      <div class="space-y-4 md:col-span-1">
        <a href="/" class="group flex flex-col" aria-label="Sportivo home">
          <span class="flex items-center gap-2.5">
            <span class="relative flex h-2.5 w-2.5">
              <span class="site-logo-dot relative inline-flex h-2.5 w-2.5 rounded-full"></span>
            </span>
            <span class="text-xl font-black tracking-tight text-white">Sportivo<span class="site-accent">.</span></span>
          </span>
          <span class="text-xs font-bold uppercase tracking-wider text-slate-400 mt-1">Live sports fixtures desk</span>
        </a>
        <p class="text-xs leading-relaxed text-slate-400">
          Independent sports schedule platform engineered in Nepal. Real-time scores, NST kickoff times, and upstream stream links.
        </p>
        <div class="pt-1">
          <a
            href="/about-dipesh-sapkota/"
            class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-bold text-slate-300 hover:border-[#c9f36b]/40 hover:bg-[#c9f36b]/10 hover:text-[#c9f36b] transition"
          >
            <img src="/dipesh-sapkota-profile.webp" alt="Creator profile" width="18" height="18" class="h-4 w-4 rounded-full object-cover border border-[#c9f36b]" />
            <span>About the Creator &rarr;</span>
          </a>
        </div>
      </div>

      <!-- Col 2: Sports Sitelinks -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#e5b94f]">Fixtures & Hubs</p>
        <ul class="mt-4 space-y-2.5 text-xs">
          <li>
            <a href="/" class="hover:text-[#c9f36b] transition">Live Fixtures Desk (Home)</a>
          </li>
          {categories.map((cat) => (
            <li>
              <a href={`/${cat}/`} class="capitalize hover:text-[#c9f36b] transition">
                {cat} fixtures & streams
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 3: About & Developer -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#e5b94f]">About & Dev</p>
        <ul class="mt-4 space-y-2.5 text-xs">
          <li>
            <a href="/about-dipesh-sapkota/" class="font-bold text-slate-200 hover:text-[#c9f36b] transition">
              About the Creator
            </a>
          </li>
          <li>
            <a href="/api-docs/" class="hover:text-[#c9f36b] transition">
              Public Developer API
            </a>
          </li>
          <li>
            <a href="/sitemap.xml" target="_blank" class="hover:text-[#c9f36b] transition">
              XML Sitemap
            </a>
          </li>
          <li>
            <a href="/llms.txt" target="_blank" class="hover:text-[#c9f36b] transition">
              LLMs Machine Summary
            </a>
          </li>
          <li>
            <a href="/robots.txt" target="_blank" class="hover:text-[#c9f36b] transition">
              Robots.txt Directive
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 4: Social Media Links (Icons Only) -->
      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-[#e5b94f]">Connect</p>
        <p class="mt-2 text-xs text-slate-400">Developer profiles & code repositories.</p>
        <nav aria-label="Social media links" class="mt-4 flex flex-wrap items-center gap-2.5">
          <a
            href="https://www.dipeshsapkota7.com.np/"
            rel="me author external"
            target="_blank"
            title="Personal Website"
            aria-label="Personal Website"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 hover:border-[#c9f36b]/50 hover:bg-[#c9f36b]/10 hover:text-[#c9f36b] transition-all"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </a>
          <a
            href="https://github.com/dszae"
            rel="me author external"
            target="_blank"
            title="GitHub"
            aria-label="GitHub"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 hover:border-[#c9f36b]/50 hover:bg-[#c9f36b]/10 hover:text-[#c9f36b] transition-all"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
          <a
            href="https://linkedin.com/in/dszae"
            rel="me author external"
            target="_blank"
            title="LinkedIn"
            aria-label="LinkedIn"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 hover:border-[#c9f36b]/50 hover:bg-[#c9f36b]/10 hover:text-[#c9f36b] transition-all"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c-.97 0-1.75-.79-1.75-1.76s.78-1.75 1.75-1.75 1.75.78 1.75 1.75-.78 1.76-1.75 1.76m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
            </svg>
          </a>
          <a
            href="https://facebook.com/dsz.ae"
            rel="me author external"
            target="_blank"
            title="Facebook"
            aria-label="Facebook"
            class="flex h-9 w-9 items-center justify-center rounded-xl border border-white/10 bg-white/5 text-slate-300 hover:border-[#c9f36b]/50 hover:bg-[#c9f36b]/10 hover:text-[#c9f36b] transition-all"
          >
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </nav>
      </div>
    </div>

    <!-- Bottom line -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-8 text-xs text-slate-400 sm:flex-row">
      <p>
        &copy; {currentYear} Sportivo. All rights reserved.
      </p>
      <p class="flex items-center gap-3">
        <span>Nepal Standard Time (UTC+5:45)</span>
        <span>&bull;</span>
        <span>Engineered in Nepal</span>
      </p>
    </div>
  </div>
</footer>
