---
interface Props {
  activeCategory?: string;
}

const { activeCategory } = Astro.props;

const items = [
  { href: '/', key: 'home', label: 'Home', icon: 'M3 10l9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z' },
  { href: '/football/', key: 'football', label: 'Football', icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm0 0a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10zM2 12h20' },
  { href: '/npl/', key: 'npl', label: 'NPL', icon: 'M6 9H4.5a2.5 2.5 0 0 1 0-5H6M18 9h1.5a2.5 2.5 0 0 0 0-5H18M4 22h16M10 15v2a1 1 0 0 1-1 1H7M14 15v2a1 1 0 0 0 1 1h2M18 2H6v7a6 6 0 0 0 12 0z', live: true },
  { href: '/cricket/', key: 'cricket', label: 'Cricket', icon: 'M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM4.9 4.9l4.3 4.3M14.8 9.2l4.3-4.3M14.8 14.8l4.3 4.3M9.2 14.8l-4.3 4.3' },
  { href: '/dashboard/', key: 'dashboard', label: 'Watchlist', icon: 'M12 3l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.8 6.2 20.9l1.1-6.5L2.6 9.8l6.5-.9z' },
];

const isActive = (key: string) => (key === 'home' ? !activeCategory || activeCategory === 'home' : activeCategory === key);
---

<nav
  aria-label="Mobile navigation"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-ink-950/95 px-2 pt-2 pb-[max(0.5rem,env(safe-area-inset-bottom))] backdrop-blur-md sm:hidden"
>
  <div class="mx-auto flex max-w-md items-center justify-around">
    {items.map((item) => (
      <a
        href={item.href}
        aria-label={item.label}
        aria-current={isActive(item.key) ? 'page' : undefined}
        class:list={[
          'relative flex min-w-[56px] flex-col items-center gap-1 rounded-lg px-2 py-1 transition-colors duration-fast ease-out',
          isActive(item.key) ? 'text-fg' : 'text-fg-3 hover:text-fg-2',
        ]}
      >
        <span class="relative">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={item.icon} />
          </svg>
          {item.live && <span class="absolute -right-1 -top-0.5 h-1.5 w-1.5 rounded-full bg-live" aria-hidden="true"></span>}
        </span>
        <span class="text-xs leading-none">{item.label}</span>
        {isActive(item.key) && <span class="absolute -bottom-2 h-0.5 w-5 rounded-full bg-lime" aria-hidden="true"></span>}
      </a>
    ))}
  </div>
</nav>
