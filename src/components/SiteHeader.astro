---
import type { Category } from '../lib/sportivo';
import NotificationCenter from './NotificationCenter';
import MobileNav from './MobileNav.astro';
import DownloadApkButton from './InstallPrompt';
import MobileAppBanner from './MobileAppBanner';
import ThemeToggle from './ThemeToggle';

interface Props {
  activeCategory?: Category | 'creator' | 'api-docs' | 'dashboard' | 'npl';
}

const { activeCategory } = Astro.props;

const links: { href: string; label: string; key: string; live?: boolean }[] = [
  { href: '/football/', label: 'Football', key: 'football' },
  { href: '/cricket/', label: 'Cricket', key: 'cricket' },
  { href: '/basketball/', label: 'Basketball', key: 'basketball' },
  { href: '/npl/', label: 'NPL 2026', key: 'npl', live: true },
];
---
<header class="site-header sticky top-0 z-50 -mb-14 border-b border-transparent" itemscope itemtype="https://schema.org/WPHeader">
  <div class="mx-auto flex h-14 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="Sportivo home">
      <span class="h-2 w-2 rounded-full bg-lime shadow-[0_0_8px_rgba(201,243,107,0.7)]" aria-hidden="true"></span>
      <span class="brand-title text-[17px] font-semibold leading-none text-fg">Sportivo</span>
    </a>

    <nav aria-label="Sports" class="hidden md:flex items-center gap-1" itemscope itemtype="https://schema.org/SiteNavigationElement">
      {links.map((link) => (
        <a
          href={link.href}
          itemprop="url"
          aria-current={activeCategory === link.key ? 'page' : undefined}
          class:list={['chip', activeCategory === link.key && 'chip-active']}
        >
          {link.live && <span class="h-1.5 w-1.5 rounded-full bg-live" aria-hidden="true"></span>}
          <span itemprop="name">{link.label}</span>
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center gap-2">
      <a
        href="/dashboard/"
        aria-label="Watchlist"
        title="Watchlist"
        class:list={['chip', activeCategory === 'dashboard' && 'chip-active']}
      >
        <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.8 6.2 20.9l1.1-6.5L2.6 9.8l6.5-.9z"/>
        </svg>
        <span class="hidden sm:inline">Watchlist</span>
      </a>

      <NotificationCenter client:load />

      <ThemeToggle client:load />

      <div class="md:hidden flex items-center">
        <DownloadApkButton client:load />
      </div>
    </div>
  </div>
</header>

<MobileAppBanner client:load />

<MobileNav activeCategory={activeCategory} />

<script is:inline>
  (() => {
    function initHeaderScroll() {
      const header = document.querySelector('.site-header');
      if (!header) return;

      let ticking = false;
      const checkScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            if (window.scrollY > 8) {
              header.classList.add('is-scrolled');
            } else {
              header.classList.remove('is-scrolled');
            }
            ticking = false;
          });
          ticking = true;
        }
      };

      window.addEventListener('scroll', checkScroll, { passive: true });
      checkScroll();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeaderScroll);
    } else {
      initHeaderScroll();
    }
    document.addEventListener('astro:page-load', initHeaderScroll);
  })();
</script>
