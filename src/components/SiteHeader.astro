---
import { categories, type Category } from '../lib/sportivo';

interface Props {
  activeCategory?: Category | 'creator' | 'api-docs' | 'dashboard';
}

const { activeCategory } = Astro.props;
---
<header class="site-header sticky top-0 z-50 border-b bg-[#101716]/95 backdrop-blur" itemscope itemtype="https://schema.org/WPHeader">
  <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-4 px-6 py-3.5 sm:flex-row">
    <a href="/" class="group flex flex-col" aria-label="Sportivo Home - Live Sports Fixtures Desk">
      <span class="flex items-center gap-3">
        <span class="relative flex h-3 w-3">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#e5b94f] opacity-50"></span>
          <span class="site-logo-dot relative inline-flex h-3 w-3 rounded-full"></span>
        </span>
        <span class="text-2xl font-black leading-none tracking-tight text-white">Sportivo<span class="site-accent">.</span></span>
      </span>
      <span class="ml-6 mt-0.5 text-xs font-bold uppercase tracking-wider text-slate-400 group-hover:text-[#c9f36b] transition-colors">Live Sports Desk · Nepal</span>
    </a>

    <nav aria-label="Main Navigation" class="flex flex-wrap items-center justify-center gap-2" itemscope itemtype="https://schema.org/SiteNavigationElement">
      {categories.map((category) => (
        <a
          href={`/${category}/`}
          itemprop="url"
          aria-current={activeCategory === category ? 'page' : undefined}
          class:list={[
            "rounded-full px-4 py-1.5 text-xs font-bold capitalize transition-all",
            activeCategory === category
              ? 'site-button-active'
              : 'bg-white/5 text-slate-300 hover:bg-white/10 hover:text-white'
          ]}
        >
          <span itemprop="name">{category[0].toUpperCase() + category.slice(1)}</span>
        </a>
      ))}

      <a
        href="/dashboard/"
        itemprop="url"
        aria-current={activeCategory === 'dashboard' ? 'page' : undefined}
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-xs font-bold transition-all border",
          activeCategory === 'dashboard'
            ? 'site-button-active border-[#c9f36b]'
            : 'border-white/10 bg-white/5 text-slate-300 hover:border-[#c9f36b]/40 hover:text-[#c9f36b]'
        ]}
        title="My Saved Watchlist"
      >
        <span aria-hidden="true">★</span>
        <span itemprop="name">My Watchlist</span>
      </a>

      <a
        href="/about-dipesh-sapkota/"
        itemprop="url"
        aria-current={activeCategory === 'creator' ? 'page' : undefined}
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full px-4 py-1.5 text-xs font-bold transition-all border",
          activeCategory === 'creator'
            ? 'site-button-active border-[#c9f36b]'
            : 'border-white/15 bg-white/5 text-slate-300 hover:border-[#c9f36b]/40 hover:bg-[#c9f36b]/10 hover:text-[#c9f36b]'
        ]}
        title="About the Creator"
      >
        <svg class="h-3.5 w-3.5 text-slate-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="12" y1="16" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12.01" y2="8"></line>
        </svg>
        <span itemprop="name">About</span>
      </a>
    </nav>
  </div>
</header>