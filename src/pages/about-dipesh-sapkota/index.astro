---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const title = 'Dipesh Sapkota | Creator of Sportivo - Software Developer & Student';
const description = 'Official profile of Dipesh Sapkota, engineering student, software developer, and the creator and publisher of Sportivo sports fixtures desk in Nepal.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/';
const profileImageUrl = 'https://sportivo.dipeshsapkota7.com.np/dipesh-sapkota-profile.webp';

const faqs = [
  {
    question: 'Who created Sportivo?',
    answer: 'Sportivo was created and published by Dipesh Sapkota, a software developer and engineering student from Nepal.',
  },
  {
    question: 'What is Sportivo?',
    answer: 'Sportivo is an independent sports platform that aggregates football, cricket, and basketball fixtures, converts kickoff times to Nepal Standard Time (NST), and displays verified live stream availability from upstream sports providers.',
  },
  {
    question: 'Where can I find the developer profiles and code?',
    answer: 'You can explore Dipesh’s personal portfolio at dipeshsapkota7.com.np, inspect open-source software on GitHub (@dszae), and connect on LinkedIn and Facebook.',
  },
  {
    question: 'How are kickoff times and streams provided on Sportivo?',
    answer: 'Sportivo processes fixture data from upstream sports APIs and converts timestamps into Nepal Standard Time (UTC+5:45). Live streams and fallbacks are dynamically resolved so fans have fast access to sports broadcasts.',
  },
];

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  'dateCreated': '2026-01-01T00:00:00.000Z',
  'dateModified': '2026-10-19T10:45:00.000Z',
  'primaryImageOfPage': {
    '@type': 'ImageObject',
    '@id': `${canonical}#profile-image`
  },
  'mainEntity': {
    '@type': 'Person',
    '@id': 'https://www.dipeshsapkota7.com.np/#person',
    'name': 'Dipesh Sapkota',
    'alternateName': ['Dipesh', 'dszae'],
    'identifier': 'dszae',
    'url': canonical,
    'image': {
      '@type': 'ImageObject',
      '@id': `${canonical}#profile-image`,
      'url': profileImageUrl,
      'contentUrl': profileImageUrl,
      'name': 'Dipesh Sapkota Profile Photo',
      'caption': 'Dipesh Sapkota, engineering student, software developer, and the creator and publisher of Sportivo',
      'creditText': 'Dipesh Sapkota',
      'creator': {
        '@type': 'Person',
        '@id': 'https://www.dipeshsapkota7.com.np/#person',
        'name': 'Dipesh Sapkota',
        'url': 'https://www.dipeshsapkota7.com.np/'
      },
      'copyrightNotice': 'Copyright 2026 Dipesh Sapkota',
      'license': canonical,
      'acquireLicensePage': canonical
    },
    'description': 'Dipesh Sapkota is the creator and publisher of Sportivo, an engineering student, software developer, and builder from Nepal.',
    'jobTitle': 'Software Developer & Engineering Student',
    'nationality': {
      '@type': 'Country',
      'name': 'Nepal'
    },
    'worksFor': {
      '@type': 'Organization',
      'name': 'Sportivo',
      'url': 'https://sportivo.dipeshsapkota7.com.np/'
    },
    'sameAs': [
      'https://www.dipeshsapkota7.com.np/',
      'https://github.com/dszae',
      'https://www.linkedin.com/in/dipeshsapkota7/',
      'https://facebook.com/dsz.ae'
    ],
    'knowsAbout': [
      'Sportivo',
      'Sports Streaming Platforms',
      'Football Fixtures & Kickoff Times',
      'Cricket Schedules',
      'Basketball Schedules',
      'React & Astro Development',
      'Web Development',
      'Machine Learning'
    ]
  },
  'breadcrumb': {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Sportivo Home',
        'item': 'https://sportivo.dipeshsapkota7.com.np/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Dipesh Sapkota (Creator)',
        'item': canonical
      }
    ]
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer
    }
  }))
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="profile"
  image="/dipesh-sapkota-profile.webp"
  imageAlt="Dipesh Sapkota - Creator and developer of Sportivo"
  imageWidth={627}
  imageHeight={627}
  imageType="image/webp"
  keywords="Dipesh Sapkota, Dipesh, dszae, Sportivo creator, Dipesh Sapkota Nepal, software developer Nepal, engineering student Nepal, Sportivo publisher"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/dipesh-sapkota-profile.webp" type="image/webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <SiteHeader activeCategory="creator" />

  <main class="site-shell min-h-screen">
    <article
      class="mx-auto max-w-3xl px-4 pb-24 pt-8 sm:px-6 lg:px-8"
      itemscope
      itemtype="https://schema.org/Person"
      itemid="https://www.dipeshsapkota7.com.np/#person"
    >
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-fg-3">
        <a href="/" class="transition-colors duration-fast ease-out hover:text-fg">Home</a>
        <span aria-hidden="true">/</span>
        <span class="text-fg-2" aria-current="page">About</span>
      </nav>

      <figure
        class="mt-10 flex flex-col items-start gap-6 sm:flex-row sm:items-center"
        itemprop="image"
        itemscope
        itemtype="https://schema.org/ImageObject"
      >
        <meta itemprop="name" content="Dipesh Sapkota Profile Photo" />
        <meta itemprop="caption" content="Dipesh Sapkota, engineering student, software developer, and the creator and publisher of Sportivo" />
        <meta itemprop="description" content="Official portrait profile photo of Dipesh Sapkota, creator and publisher of Sportivo sports platform." />
        <meta itemprop="width" content="627" />
        <meta itemprop="height" content="627" />
        <meta itemprop="encodingFormat" content="image/webp" />
        <meta itemprop="license" content={canonical} />
        <meta itemprop="acquireLicensePage" content={canonical} />
        <meta itemprop="creditText" content="Dipesh Sapkota" />
        <meta itemprop="copyrightNotice" content="Copyright 2026 Dipesh Sapkota" />
        <link itemprop="url" href={profileImageUrl} />
        <span itemprop="creator" itemscope itemtype="https://schema.org/Person">
          <meta itemprop="name" content="Dipesh Sapkota" />
          <link itemprop="url" href="https://www.dipeshsapkota7.com.np/" />
        </span>
        <img
          src="/dipesh-sapkota-profile.webp"
          width="627"
          height="627"
          alt="Dipesh Sapkota, creator and publisher of Sportivo"
          title="Dipesh Sapkota"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="h-32 w-32 rounded-2xl border border-line object-cover"
          itemprop="contentUrl"
        />
        <figcaption>
          <p class="eyebrow">Creator and publisher</p>
          <h1 class="mt-2 text-4xl font-medium tracking-[-0.02em] text-fg sm:text-5xl" itemprop="name">Dipesh Sapkota</h1>
          <p class="mt-2 text-base text-fg-2" itemprop="jobTitle">Software developer and engineering student, Nepal</p>
        </figcaption>
      </figure>

      <section class="mt-12 flex flex-col gap-4 border-y border-line py-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-base text-fg">Sportivo</p>
          <p class="mt-1 text-sm text-fg-2">Football, cricket and basketball fixtures, scores and streams in Nepal Standard Time</p>
        </div>
        <a href="/" class="btn btn-secondary shrink-0">Open fixtures</a>
      </section>

      <section class="mt-12 space-y-6 text-base leading-7 text-fg-2" itemprop="description">
        <h2 class="text-2xl font-medium text-fg">About</h2>
        <p>
          Dipesh Sapkota is a software developer, engineering student and open-source builder based in Nepal. He is the founder, lead engineer and publisher of <strong class="font-medium text-fg">Sportivo</strong>, an independent sports desk built to bridge the gap between global sports schedules and fans in Nepal.
        </p>

        <h3 class="pt-2 text-xl font-medium text-fg">Why Sportivo exists</h3>
        <p>
          Following the Premier League, La Liga, the Champions League, international cricket and the NBA from Nepal has always meant converting kickoff times from GMT, CET or EST by hand, and hunting for streams scattered across broadcasters with geo-restrictions.
        </p>
        <p>
          Sportivo pulls fixture data from global providers, converts every kickoff to <span class="clock text-fg">Nepal Standard Time, UTC+5:45</span>, and keeps several stream servers per match so a dead link does not mean a missed kickoff.
        </p>

        <h3 class="pt-2 text-xl font-medium text-fg">How it is built</h3>
        <ul class="list-disc space-y-2 pl-6 text-[15px]">
          <li><strong class="font-medium text-fg">Astro on the edge.</strong> Server-rendered pages served from edge networks, so first byte stays fast on mobile networks in Nepal.</li>
          <li><strong class="font-medium text-fg">Islands only where needed.</strong> Fixtures are plain HTML; React loads only for live countdowns, the player and the watchlist.</li>
          <li><strong class="font-medium text-fg">Stream fallback.</strong> Local API proxies are tried first, then upstream broadcast signals.</li>
          <li><strong class="font-medium text-fg">Accessible by default.</strong> High-contrast type, keyboard navigation and semantic landmarks.</li>
        </ul>

        <h3 class="pt-2 text-xl font-medium text-fg">Elsewhere</h3>
        <p>
          Beyond Sportivo, Dipesh contributes to open-source software, builds admission guidance portals, and does research in applied machine learning and distributed systems.
        </p>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-medium text-fg">Links</h2>
        <nav aria-label="Creator social and profile links" class="mt-4 flex flex-wrap items-center gap-2">
          <a href="https://www.dipeshsapkota7.com.np/" rel="me author external" target="_blank" title="Website" aria-label="Website" class="icon-btn" itemprop="sameAs">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zM2 12h20M12 2a15 15 0 0 1 4 10 15 15 0 0 1-4 10 15 15 0 0 1-4-10 15 15 0 0 1 4-10z"/></svg>
          </a>
          <a href="https://github.com/dszae" rel="me author external" target="_blank" title="GitHub" aria-label="GitHub" class="icon-btn" itemprop="sameAs">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 19c-4.3 1.4-4.3-2.5-6-3m12 5v-3.5c0-1 .1-1.4-.5-2 2.8-.3 5.5-1.4 5.5-6a4.6 4.6 0 0 0-1.3-3.2 4.2 4.2 0 0 0-.1-3.2s-1.1-.3-3.5 1.3a12.3 12.3 0 0 0-6.2 0C6.5 2.8 5.4 3.1 5.4 3.1a4.2 4.2 0 0 0-.1 3.2A4.6 4.6 0 0 0 4 9.5c0 4.6 2.7 5.7 5.5 6-.6.6-.6 1.2-.5 2V21"/></svg>
          </a>
          <a href="https://www.linkedin.com/in/dipeshsapkota7/" rel="me author external" target="_blank" title="LinkedIn" aria-label="LinkedIn" class="icon-btn" itemprop="sameAs">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6zM2 9h4v12H2zM4 6a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/></svg>
          </a>
          <a href="https://facebook.com/dsz.ae" rel="me author external" target="_blank" title="Facebook" aria-label="Facebook" class="icon-btn" itemprop="sameAs">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
        </nav>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-medium text-fg">On Sportivo</h2>
        <ul class="mt-4 divide-y divide-line">
          <li><a href="/" class="row -mx-4 h-12 py-0 text-sm text-fg"><span class="flex-1">All fixtures</span><span class="meta">Home</span></a></li>
          <li><a href="/npl/" class="row -mx-4 h-12 py-0 text-sm text-fg"><span class="flex-1">NPL 2026</span><span class="meta">Cricket, Nepal</span></a></li>
          <li><a href="/football/" class="row -mx-4 h-12 py-0 text-sm text-fg"><span class="flex-1">Football</span><span class="meta">Leagues and streams</span></a></li>
          <li><a href="/cricket/" class="row -mx-4 h-12 py-0 text-sm text-fg"><span class="flex-1">Cricket</span><span class="meta">Schedules in NST</span></a></li>
          <li><a href="/basketball/" class="row -mx-4 h-12 py-0 text-sm text-fg"><span class="flex-1">Basketball</span><span class="meta">NBA and more</span></a></li>
        </ul>
      </section>

      <section class="mt-16 border-t border-line pt-12">
        <p class="eyebrow">Questions</p>
        <h2 class="mt-3 text-2xl font-medium text-fg">Common questions</h2>
        <dl class="mt-6 divide-y divide-line">
          {faqs.map((faq) => (
            <div class="py-5 first:pt-0 last:pb-0">
              <dt class="text-base font-medium text-fg">{faq.question}</dt>
              <dd class="mt-2 text-sm leading-6 text-fg-2">{faq.answer}</dd>
            </div>
          ))}
        </dl>
      </section>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>
