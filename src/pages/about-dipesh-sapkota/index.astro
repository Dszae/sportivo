---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const title = 'Dipesh Sapkota | Creator of Sportivo - Software Developer & Student';
const description = 'Official profile of Dipesh Sapkota, engineering student, software developer, and the creator and publisher of Sportivo sports fixtures desk in Nepal.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/';
const profileImageUrl = 'https://sportivo.dipeshsapkota7.com.np/dipesh-sapkota-profile.webp';

const faqs = [
  {
    question: 'Who is Dipesh Sapkota?',
    answer: 'Dipesh Sapkota is an engineering student, software developer, and AI/ML enthusiast from Nepal. He is the creator and publisher of Sportivo, a live sports fixtures desk providing real-time scores, schedules, and stream links.',
  },
  {
    question: 'What is Sportivo created by Dipesh Sapkota?',
    answer: 'Sportivo is an independent sports platform built by Dipesh Sapkota that aggregates football, cricket, and basketball fixtures, converts kickoff times to Nepal Standard Time (NST), and displays verified live stream availability from upstream sports providers.',
  },
  {
    question: 'Where can I find Dipesh Sapkota’s code and public profiles?',
    answer: 'You can explore Dipesh Sapkota’s personal portfolio at dipeshsapkota7.com.np, view his open-source software on GitHub (@dszae), and connect with him on LinkedIn and Facebook.',
  },
  {
    question: 'How are kickoff times and streams provided on Sportivo?',
    answer: 'Sportivo processes fixture data from upstream sports APIs and converts timestamps into Nepal Standard Time (UTC+5:45). Live streams and fallbacks are dynamically resolved so fans have fast access to sports broadcasts.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      'url': canonical,
      'name': title,
      'description': description,
      'isPartOf': {
        '@type': 'WebSite',
        '@id': 'https://sportivo.dipeshsapkota7.com.np/#website',
        'url': 'https://sportivo.dipeshsapkota7.com.np/',
        'name': 'Sportivo',
        'description': 'Sports fixtures desk for football, cricket, and basketball schedules and streams by Dipesh Sapkota.',
        'publisher': {
          '@id': 'https://www.dipeshsapkota7.com.np/#person'
        }
      },
      'breadcrumb': {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          {
            '@type': 'ListItem',
            'position': 1,
            'name': 'Sportivo Home',
            'item': 'https://sportivo.dipeshsapkota7.com.np/'
          },
          {
            '@type': 'ListItem',
            'position': 2,
            'name': 'Dipesh Sapkota (Creator)',
            'item': canonical
          }
        ]
      },
      'mainEntity': {
        '@type': 'Person',
        '@id': 'https://www.dipeshsapkota7.com.np/#person',
        'name': 'Dipesh Sapkota',
        'alternateName': ['Dipesh', 'dszae'],
        'url': 'https://www.dipeshsapkota7.com.np/',
        'jobTitle': 'Software Developer & Engineering Student',
        'description': 'Dipesh Sapkota is the creator and publisher of Sportivo, an engineering student, AI/ML enthusiast, and software builder from Nepal.',
        'nationality': {
          '@type': 'Country',
          'name': 'Nepal'
        },
        'sameAs': [
          'https://www.dipeshsapkota7.com.np/',
          'https://github.com/dszae',
          'https://linkedin.com/in/dszae',
          'https://facebook.com/dsz.ae'
        ],
        'knowsAbout': [
          'Sportivo',
          'Sports Streaming Platforms',
          'Football Fixtures & Kickoff Times',
          'Cricket Schedules',
          'Basketball Schedules',
          'React & Astro Development',
          'Web Development',
          'Machine Learning'
        ],
        'image': {
          '@type': 'ImageObject',
          '@id': `${profileImageUrl}#image`,
          'url': profileImageUrl,
          'contentUrl': profileImageUrl,
          'thumbnailUrl': profileImageUrl,
          'name': 'Dipesh Sapkota Profile Photo',
          'caption': 'Dipesh Sapkota, creator and developer of Sportivo',
          'description': 'Official portrait profile photograph of Dipesh Sapkota, creator and publisher of Sportivo.',
          'width': 627,
          'height': 627,
          'encodingFormat': 'image/webp',
          'representativeOfPage': true,
          'author': {
            '@id': 'https://www.dipeshsapkota7.com.np/#person'
          },
          'creator': {
            '@id': 'https://www.dipeshsapkota7.com.np/#person'
          },
          'copyrightHolder': {
            '@id': 'https://www.dipeshsapkota7.com.np/#person'
          },
          'creditText': 'Dipesh Sapkota',
          'copyrightNotice': 'Copyright 2026 Dipesh Sapkota',
          'license': canonical,
          'acquireLicensePage': canonical
        }
      }
    },
    {
      '@type': 'ImageObject',
      '@id': `${profileImageUrl}#image`,
      'url': profileImageUrl,
      'contentUrl': profileImageUrl,
      'thumbnailUrl': profileImageUrl,
      'name': 'Dipesh Sapkota Profile Photo',
      'caption': 'Dipesh Sapkota, creator and developer of Sportivo',
      'description': 'Official portrait profile photograph of Dipesh Sapkota, creator and publisher of Sportivo.',
      'width': 627,
      'height': 627,
      'encodingFormat': 'image/webp',
      'representativeOfPage': true,
      'author': {
        '@id': 'https://www.dipeshsapkota7.com.np/#person'
      },
      'creator': {
        '@id': 'https://www.dipeshsapkota7.com.np/#person'
      },
      'creditText': 'Dipesh Sapkota',
      'copyrightNotice': 'Copyright 2026 Dipesh Sapkota. All rights reserved.',
      'license': canonical,
      'acquireLicensePage': canonical
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      'mainEntity': faqs.map((faq) => ({
        '@type': 'Question',
        'name': faq.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.answer
        }
      }))
    }
  ]
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="profile"
  image="/dipesh-sapkota-profile.webp"
  imageAlt="Dipesh Sapkota - Creator and developer of Sportivo"
  imageWidth={627}
  imageHeight={627}
  imageType="image/webp"
  keywords="Dipesh Sapkota, Dipesh, dszae, Sportivo creator, Dipesh Sapkota Nepal, software developer Nepal, engineering student Nepal, Sportivo publisher"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/dipesh-sapkota-profile.webp" type="image/webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SiteHeader activeCategory="creator" />

  <main class="site-shell min-h-screen text-slate-100">
    <article
      class="mx-auto max-w-3xl px-6 pb-20 pt-12 sm:pt-16"
      itemscope
      itemtype="https://schema.org/Person"
      itemid="https://www.dipeshsapkota7.com.np/#person"
    >
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="text-xs text-slate-500">
        <a href="/" class="hover:text-[#c9f36b] transition">Sportivo</a>
        <span class="mx-2">/</span>
        <span class="text-slate-300">About the creator (Dipesh Sapkota)</span>
      </nav>

      <!-- Profile Header -->
      <figure class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-6" itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
        <img
          src="/dipesh-sapkota-profile.webp"
          width="627"
          height="627"
          alt="Dipesh Sapkota - Creator and publisher of Sportivo"
          title="Dipesh Sapkota"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="h-44 w-44 rounded-3xl object-cover border-2 border-[#526a38] shadow-2xl shadow-black/80 ring-4 ring-[#c9f36b]/20"
          itemprop="contentUrl"
        />
        <figcaption class="space-y-1">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#e5b94f]">Author & Publisher</p>
          <h1 class="text-3xl font-black tracking-tight text-white sm:text-5xl" itemprop="name">
            Dipesh Sapkota
          </h1>
          <p class="text-sm font-bold text-[#c9f36b]" itemprop="jobTitle">
            Software Developer &amp; Engineering Student
          </p>
          <p class="text-xs text-slate-400">
            Creator &amp; Publisher of Sportivo · Nepal (Asia/Kathmandu)
          </p>
        </figcaption>
      </figure>

      <!-- Sitelink Callout Banner to Sportivo Main Page -->
      <section class="mt-10 rounded-2xl border border-[#c9f36b]/30 bg-gradient-to-br from-[#121c19] via-[#101b17] to-[#0d1614] p-6 shadow-xl sm:p-7">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-black uppercase tracking-widest text-[#e5b94f]">Flagship Project</p>
            <h2 class="text-xl font-black text-white mt-1">Sportivo — Live Sports Fixture Desk</h2>
            <p class="mt-2 text-xs leading-relaxed text-slate-300 max-w-lg">
              Check live football, cricket, and basketball scores, schedules in Nepal Standard Time (NST), and verified stream fallbacks.
            </p>
          </div>
          <a
            href="/"
            class="site-button-active inline-flex shrink-0 items-center gap-2 rounded-full px-5 py-2.5 text-xs font-black transition-all hover:scale-105"
          >
            <span>Open Sportivo Desk</span>
            <span>&rarr;</span>
          </a>
        </div>
      </section>

      <!-- Biography -->
      <section class="mt-12 space-y-4 text-base leading-8 text-slate-300" itemprop="description">
        <h2 class="text-2xl font-black text-white">About Dipesh Sapkota</h2>
        <p>
          Dipesh Sapkota is the creator and publisher of Sportivo, an independent sports web platform built to give fans instantaneous access to football, cricket, and basketball schedules, kickoff times calibrated for Nepal Standard Time (UTC+5:45), and multi-server stream source availability.
        </p>
        <p>
          With a focus on performance, modern web architecture, and AI/ML engineering, Dipesh created Sportivo using high-performance server-side rendering, resilient upstream API integration, and clean accessibility.
        </p>
      </section>

      <!-- Verified Links -->
      <section class="mt-12">
        <h2 class="text-2xl font-black text-white">Verified Profiles &amp; Web Presence</h2>
        <nav aria-label="Dipesh Sapkota public profiles" class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-sm font-semibold">
          <a
            href="https://www.dipeshsapkota7.com.np/"
            rel="me author external"
            target="_blank"
            class="flex items-center justify-between rounded-xl border border-white/10 bg-[#111a19] p-4 text-[#c9f36b] hover:bg-white/5 transition"
            itemprop="sameAs"
          >
            <span>Personal Portfolio</span>
            <span class="text-xs text-slate-400">dipeshsapkota7.com.np ↗</span>
          </a>
          <a
            href="https://github.com/dszae"
            rel="me author external"
            target="_blank"
            class="flex items-center justify-between rounded-xl border border-white/10 bg-[#111a19] p-4 text-white hover:text-[#c9f36b] hover:bg-white/5 transition"
            itemprop="sameAs"
          >
            <span>GitHub (@dszae)</span>
            <span class="text-xs text-slate-400">Code repositories ↗</span>
          </a>
          <a
            href="https://linkedin.com/in/dszae"
            rel="me author external"
            target="_blank"
            class="flex items-center justify-between rounded-xl border border-white/10 bg-[#111a19] p-4 text-white hover:text-[#c9f36b] hover:bg-white/5 transition"
            itemprop="sameAs"
          >
            <span>LinkedIn Profile</span>
            <span class="text-xs text-slate-400">dszae ↗</span>
          </a>
          <a
            href="https://facebook.com/dsz.ae"
            rel="me author external"
            target="_blank"
            class="flex items-center justify-between rounded-xl border border-white/10 bg-[#111a19] p-4 text-white hover:text-[#c9f36b] hover:bg-white/5 transition"
            itemprop="sameAs"
          >
            <span>Facebook Profile</span>
            <span class="text-xs text-slate-400">dsz.ae ↗</span>
          </a>
        </nav>
      </section>

      <!-- Sports Category Hubs -->
      <section class="mt-14">
        <h2 class="text-2xl font-black text-white">Explore Sportivo Fixture Hubs</h2>
        <div class="mt-5 grid grid-cols-1 sm:grid-cols-3 gap-3">
          <a href="/football/" class="rounded-xl border border-white/10 bg-[#111a19] p-4 text-center hover:border-[#c9f36b]/40 hover:bg-white/5 transition">
            <span class="block text-base font-bold text-white">Football</span>
            <span class="mt-1 block text-xs text-slate-400">Live leagues &amp; streams</span>
          </a>
          <a href="/cricket/" class="rounded-xl border border-white/10 bg-[#111a19] p-4 text-center hover:border-[#c9f36b]/40 hover:bg-white/5 transition">
            <span class="block text-base font-bold text-white">Cricket</span>
            <span class="mt-1 block text-xs text-slate-400">Match schedules &amp; NST</span>
          </a>
          <a href="/basketball/" class="rounded-xl border border-white/10 bg-[#111a19] p-4 text-center hover:border-[#c9f36b]/40 hover:bg-white/5 transition">
            <span class="block text-base font-bold text-white">Basketball</span>
            <span class="mt-1 block text-xs text-slate-400">NBA &amp; global fixtures</span>
          </a>
        </div>
      </section>

      <!-- Frequently Asked Questions (FAQ) with Schema Ranking Boost -->
      <section class="mt-16">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#e5b94f]">Information &amp; FAQs</p>
        <h2 class="mt-2 text-2xl font-black text-white">Frequently Asked Questions</h2>
        <div class="mt-6 space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-xl border border-white/10 bg-[#111a19] p-5">
              <h3 class="text-base font-bold text-white">{faq.question}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-300">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>