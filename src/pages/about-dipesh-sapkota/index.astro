---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';

const title = 'Dipesh Sapkota | Creator of Sportivo';
const description = 'Official profile of Dipesh Sapkota, engineering student, software developer, and the creator and publisher of Sportivo sports fixtures desk.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/';
const profileImageUrl = 'https://sportivo.dipeshsapkota7.com.np/dipesh-sapkota-profile.webp';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfilePage',
      '@id': `${canonical}#webpage`,
      'url': canonical,
      'name': title,
      'description': description,
      'isPartOf': {
        '@type': 'WebSite',
        '@id': 'https://sportivo.dipeshsapkota7.com.np/#website',
        'url': 'https://sportivo.dipeshsapkota7.com.np/',
        'name': 'Sportivo',
        'description': 'Sports fixtures desk for football, cricket, and basketball schedules and streams by Dipesh Sapkota.',
        'publisher': {
          '@id': 'https://www.dipeshsapkota7.com.np/#person'
        }
      },
      'breadcrumb': {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          {
            '@type': 'ListItem',
            'position': 1,
            'name': 'Sportivo',
            'item': 'https://sportivo.dipeshsapkota7.com.np/'
          },
          {
            '@type': 'ListItem',
            'position': 2,
            'name': 'About the creator',
            'item': canonical
          }
        ]
      },
      'mainEntity': {
        '@type': 'Person',
        '@id': 'https://www.dipeshsapkota7.com.np/#person',
        'name': 'Dipesh Sapkota',
        'alternateName': ['Dipesh', 'dszae'],
        'url': 'https://www.dipeshsapkota7.com.np/',
        'jobTitle': 'Software Developer & Engineering Student',
        'description': 'Dipesh Sapkota is the creator and publisher of Sportivo, an engineering student, AI/ML enthusiast, and software builder from Nepal.',
        'nationality': {
          '@type': 'Country',
          'name': 'Nepal'
        },
        'sameAs': [
          'https://www.dipeshsapkota7.com.np/',
          'https://github.com/dszae',
          'https://linkedin.com/in/dszae',
          'https://facebook.com/dsz.ae'
        ],
        'knowsAbout': [
          'Sportivo',
          'Sports Streaming Platforms',
          'Football Fixtures & Kickoff Times',
          'Cricket Schedules',
          'Basketball Schedules',
          'React & Astro Development',
          'Web Development',
          'Machine Learning'
        ],
        'image': {
          '@type': 'ImageObject',
          '@id': `${profileImageUrl}#image`,
          'url': profileImageUrl,
          'contentUrl': profileImageUrl,
          'thumbnailUrl': profileImageUrl,
          'name': 'Dipesh Sapkota Profile Photo',
          'caption': 'Dipesh Sapkota, creator and developer of Sportivo',
          'description': 'Official portrait profile photograph of Dipesh Sapkota, creator and publisher of Sportivo.',
          'width': {
            '@type': 'QuantitativeValue',
            'value': 627,
            'unitCode': 'E37'
          },
          'height': {
            '@type': 'QuantitativeValue',
            'value': 627,
            'unitCode': 'E37'
          },
          'encodingFormat': 'image/webp',
          'representativeOfPage': true,
          'author': {
            '@id': 'https://www.dipeshsapkota7.com.np/#person'
          },
          'creator': {
            '@id': 'https://www.dipeshsapkota7.com.np/#person'
          },
          'copyrightHolder': {
            '@id': 'https://www.dipeshsapkota7.com.np/#person'
          },
          'creditText': 'Dipesh Sapkota',
          'copyrightNotice': 'Copyright 2026 Dipesh Sapkota',
          'license': canonical,
          'acquireLicensePage': canonical
        }
      }
    },
    {
      '@type': 'ImageObject',
      '@id': `${profileImageUrl}#image`,
      'url': profileImageUrl,
      'contentUrl': profileImageUrl,
      'thumbnailUrl': profileImageUrl,
      'name': 'Dipesh Sapkota Profile Photo',
      'caption': 'Dipesh Sapkota, creator and developer of Sportivo',
      'description': 'Official portrait profile photograph of Dipesh Sapkota, creator and publisher of Sportivo.',
      'width': 627,
      'height': 627,
      'encodingFormat': 'image/webp',
      'representativeOfPage': true,
      'author': {
        '@id': 'https://www.dipeshsapkota7.com.np/#person'
      },
      'creator': {
        '@id': 'https://www.dipeshsapkota7.com.np/#person'
      },
      'creditText': 'Dipesh Sapkota',
      'copyrightNotice': 'Copyright 2026 Dipesh Sapkota. All rights reserved.',
      'license': canonical,
      'acquireLicensePage': canonical
    }
  ]
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="profile"
  image="/dipesh-sapkota-profile.webp"
  imageAlt="Dipesh Sapkota - Creator and developer of Sportivo"
  imageWidth={627}
  imageHeight={627}
  imageType="image/webp"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/dipesh-sapkota-profile.webp" type="image/webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <SiteHeader />

  <main class="site-shell min-h-screen text-slate-100">
    <article
      class="mx-auto max-w-3xl px-6 pb-20 pt-12 sm:pt-20"
      itemscope
      itemtype="https://schema.org/Person"
      itemid="https://www.dipeshsapkota7.com.np/#person"
    >
      <nav aria-label="Breadcrumb" class="text-xs text-slate-500">
        <a href="/" class="hover:text-[#c9f36b]">Sportivo</a>
        <span class="mx-2">/</span>
        <span>About the creator</span>
      </nav>

      <figure class="mt-10 flex flex-col sm:flex-row items-start sm:items-center gap-6" itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
        <img
          src="/dipesh-sapkota-profile.webp"
          width="627"
          height="627"
          alt="Dipesh Sapkota - Creator and publisher of Sportivo"
          title="Dipesh Sapkota"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="h-40 w-40 rounded-3xl object-cover border-2 border-[#526a38] shadow-2xl shadow-black/80"
          itemprop="contentUrl"
        />
        <figcaption class="text-xs text-slate-400">
          <p class="font-bold text-slate-200" itemprop="caption">Dipesh Sapkota</p>
          <p class="text-slate-400">Software Developer & Engineering Student</p>
          <p class="text-[11px] text-slate-500 mt-0.5">Creator & Publisher of Sportivo · Nepal</p>
        </figcaption>
      </figure>

      <p class="mt-10 text-xs font-bold uppercase tracking-[0.2em] text-[#e5b94f]">Author and publisher</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight text-white sm:text-6xl" itemprop="name">
        Dipesh Sapkota
      </h1>
      <p class="mt-4 text-lg font-bold text-[#c9f36b]" itemprop="jobTitle">
        Engineering student · AI/ML enthusiast · Builder
      </p>

      <div class="mt-6 space-y-4 text-base leading-8 text-slate-300" itemprop="description">
        <p>
          Dipesh Sapkota is the creator and publisher of Sportivo, an independent sports web application built for discovering football, cricket, and basketball fixtures, checking Nepal Standard Time (NST) schedules, and reviewing verified stream availability.
        </p>
        <p>
          With a strong passion for web technologies, AI/ML engineering, and high-performance applications, Dipesh built Sportivo to give sports fans a fast, clutter-free schedule desk with accurate local kickoff times and multi-server stream integration.
        </p>
      </div>

      <h2 class="mt-14 text-2xl font-black text-white">About Sportivo</h2>
      <p class="mt-4 leading-8 text-slate-300">
        Sportivo is designed as a focused live fixture desk. It features searchable schedules across global leagues, Nepal kickoff times, public fixture URLs for sharing, and graceful fallbacks for streaming servers. Live feeds are supplied by upstream providers and are automatically sorted to the top of the schedule.
      </p>

      <h2 class="mt-14 text-2xl font-black text-white">Public Profiles & Verification</h2>
      <nav aria-label="Dipesh Sapkota public profiles" class="mt-5 flex flex-wrap gap-4 text-sm font-semibold">
        <a href="https://www.dipeshsapkota7.com.np/" rel="me author external" target="_blank" class="rounded-lg border border-white/10 bg-[#111a19] px-4 py-2 text-[#c9f36b] hover:bg-white/5 transition" itemprop="sameAs">
          Personal Portfolio ↗
        </a>
        <a href="https://github.com/dszae" rel="me author external" target="_blank" class="rounded-lg border border-white/10 bg-[#111a19] px-4 py-2 text-white hover:text-[#c9f36b] hover:bg-white/5 transition" itemprop="sameAs">
          GitHub (@dszae) ↗
        </a>
        <a href="https://linkedin.com/in/dszae" rel="me author external" target="_blank" class="rounded-lg border border-white/10 bg-[#111a19] px-4 py-2 text-white hover:text-[#c9f36b] hover:bg-white/5 transition" itemprop="sameAs">
          LinkedIn ↗
        </a>
        <a href="https://facebook.com/dsz.ae" rel="me author external" target="_blank" class="rounded-lg border border-white/10 bg-[#111a19] px-4 py-2 text-white hover:text-[#c9f36b] hover:bg-white/5 transition" itemprop="sameAs">
          Facebook ↗
        </a>
      </nav>
    </article>
  </main>
</BaseLayout>