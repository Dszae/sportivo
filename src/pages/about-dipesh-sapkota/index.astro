---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const title = 'Dipesh Sapkota | Creator of Sportivo - Software Developer & Student';
const description = 'Official profile of Dipesh Sapkota, engineering student, software developer, and the creator and publisher of Sportivo sports fixtures desk in Nepal.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/';
const profileImageUrl = 'https://sportivo.dipeshsapkota7.com.np/dipesh-sapkota-profile.webp';

const faqs = [
  {
    question: 'Who created Sportivo?',
    answer: 'Sportivo was created and published by Dipesh Sapkota, a software developer and engineering student from Nepal.',
  },
  {
    question: 'What is Sportivo?',
    answer: 'Sportivo is an independent sports platform that aggregates football, cricket, and basketball fixtures, converts kickoff times to Nepal Standard Time (NST), and displays verified live stream availability from upstream sports providers.',
  },
  {
    question: 'Where can I find the developer profiles and code?',
    answer: 'You can explore Dipesh’s personal portfolio at dipeshsapkota7.com.np, inspect open-source software on GitHub (@dszae), and connect on LinkedIn and Facebook.',
  },
  {
    question: 'How are kickoff times and streams provided on Sportivo?',
    answer: 'Sportivo processes fixture data from upstream sports APIs and converts timestamps into Nepal Standard Time (UTC+5:45). Live streams and fallbacks are dynamically resolved so fans have fast access to sports broadcasts.',
  },
];

const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  'dateCreated': '2026-01-01T00:00:00.000Z',
  'dateModified': '2026-10-19T10:45:00.000Z',
  'primaryImageOfPage': {
    '@type': 'ImageObject',
    '@id': `${canonical}#profile-image`
  },
  'mainEntity': {
    '@type': 'Person',
    '@id': 'https://www.dipeshsapkota7.com.np/#person',
    'name': 'Dipesh Sapkota',
    'alternateName': ['Dipesh', 'dszae'],
    'identifier': 'dszae',
    'url': canonical,
    'image': {
      '@type': 'ImageObject',
      '@id': `${canonical}#profile-image`,
      'url': profileImageUrl,
      'contentUrl': profileImageUrl,
      'name': 'Dipesh Sapkota Profile Photo',
      'caption': 'Dipesh Sapkota, engineering student, software developer, and the creator and publisher of Sportivo',
      'creditText': 'Dipesh Sapkota',
      'creator': {
        '@type': 'Person',
        '@id': 'https://www.dipeshsapkota7.com.np/#person',
        'name': 'Dipesh Sapkota',
        'url': 'https://www.dipeshsapkota7.com.np/'
      },
      'copyrightNotice': 'Copyright 2026 Dipesh Sapkota',
      'license': canonical,
      'acquireLicensePage': canonical
    },
    'description': 'Dipesh Sapkota is the creator and publisher of Sportivo, an engineering student, software developer, and builder from Nepal.',
    'jobTitle': 'Software Developer & Engineering Student',
    'nationality': {
      '@type': 'Country',
      'name': 'Nepal'
    },
    'worksFor': {
      '@type': 'Organization',
      'name': 'Sportivo',
      'url': 'https://sportivo.dipeshsapkota7.com.np/'
    },
    'sameAs': [
      'https://www.dipeshsapkota7.com.np/',
      'https://github.com/dszae',
      'https://linkedin.com/in/dszae',
      'https://facebook.com/dsz.ae'
    ],
    'knowsAbout': [
      'Sportivo',
      'Sports Streaming Platforms',
      'Football Fixtures & Kickoff Times',
      'Cricket Schedules',
      'Basketball Schedules',
      'React & Astro Development',
      'Web Development',
      'Machine Learning'
    ]
  },
  'breadcrumb': {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Sportivo Home',
        'item': 'https://sportivo.dipeshsapkota7.com.np/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Dipesh Sapkota (Creator)',
        'item': canonical
      }
    ]
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer
    }
  }))
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="profile"
  image="/dipesh-sapkota-profile.webp"
  imageAlt="Dipesh Sapkota - Creator and developer of Sportivo"
  imageWidth={627}
  imageHeight={627}
  imageType="image/webp"
  keywords="Dipesh Sapkota, Dipesh, dszae, Sportivo creator, Dipesh Sapkota Nepal, software developer Nepal, engineering student Nepal, Sportivo publisher"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/dipesh-sapkota-profile.webp" type="image/webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <SiteHeader activeCategory="creator" />

  <main class="site-shell min-h-screen text-slate-100">
    <article
      class="mx-auto max-w-3xl px-6 pb-20 pt-12 sm:pt-16"
      itemscope
      itemtype="https://schema.org/Person"
      itemid="https://www.dipeshsapkota7.com.np/#person"
    >
      <!-- Breadcrumb -->
      <nav aria-label="Breadcrumb" class="text-xs text-slate-400">
        <a href="/" class="text-slate-300 underline underline-offset-2 decoration-slate-600 hover:decoration-[#c9f36b] hover:text-[#c9f36b] transition">Sportivo</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-slate-300">About the creator</span>
      </nav>

      <!-- Profile Header -->
      <figure
        class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-6"
        itemprop="image"
        itemscope
        itemtype="https://schema.org/ImageObject"
      >
        <meta itemprop="name" content="Dipesh Sapkota Profile Photo" />
        <meta itemprop="caption" content="Dipesh Sapkota, engineering student, software developer, and the creator and publisher of Sportivo" />
        <meta itemprop="description" content="Official portrait profile photo of Dipesh Sapkota, creator and publisher of Sportivo sports platform." />
        <meta itemprop="width" content="627" />
        <meta itemprop="height" content="627" />
        <meta itemprop="encodingFormat" content="image/webp" />
        <meta itemprop="license" content={canonical} />
        <meta itemprop="acquireLicensePage" content={canonical} />
        <meta itemprop="creditText" content="Dipesh Sapkota" />
        <meta itemprop="copyrightNotice" content="Copyright 2026 Dipesh Sapkota" />
        <link itemprop="url" href={profileImageUrl} />
        <span itemprop="creator" itemscope itemtype="https://schema.org/Person">
          <meta itemprop="name" content="Dipesh Sapkota" />
          <link itemprop="url" href="https://www.dipeshsapkota7.com.np/" />
        </span>
        <img
          src="/dipesh-sapkota-profile.webp"
          width="627"
          height="627"
          alt="Dipesh Sapkota - Creator and publisher of Sportivo"
          title="Dipesh Sapkota"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="h-44 w-44 rounded-3xl object-cover border-2 border-[#526a38] shadow-2xl shadow-black/80 ring-4 ring-[#c9f36b]/20"
          itemprop="contentUrl"
        />
        <figcaption class="space-y-1">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#e5b94f]">Author & Publisher</p>
          <h1 class="text-3xl font-black tracking-tight text-white sm:text-5xl" itemprop="name">
            Dipesh Sapkota
          </h1>
          <p class="text-sm font-bold text-[#c9f36b]" itemprop="jobTitle">
            Software Developer &amp; Engineering Student
          </p>
          <p class="text-xs text-slate-300">
            Creator &amp; Publisher of Sportivo · Nepal (Asia/Kathmandu)
          </p>
        </figcaption>
      </figure>

      <!-- Sitelink Callout Banner to Sportivo Main Page -->
      <section class="mt-10 rounded-2xl border border-[#c9f36b]/30 bg-gradient-to-br from-[#121c19] via-[#101b17] to-[#0d1614] p-6 shadow-xl sm:p-7">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
          <div>
            <p class="text-xs font-black uppercase tracking-widest text-[#e5b94f]">Flagship Project</p>
            <h2 class="text-xl font-black text-white mt-1">Sportivo — Live Sports Fixture Desk</h2>
            <p class="mt-2 text-xs leading-relaxed text-slate-300 max-w-lg">
              Check live football, cricket, and basketball scores, schedules in Nepal Standard Time (NST), and verified stream fallbacks.
            </p>
          </div>
          <a
            href="/"
            class="site-button-active inline-flex shrink-0 items-center gap-2 rounded-full px-5 py-2.5 text-xs font-black transition-all hover:scale-105"
          >
            <span>Open Sportivo Desk</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </section>

      <!-- Biography & E-E-A-T Authoritative Profile -->
      <section class="mt-12 space-y-6 text-base leading-8 text-slate-300" itemprop="description">
        <h2 class="text-2xl font-black text-white">About Dipesh Sapkota</h2>
        <p>
          Dipesh Sapkota is a software developer, engineering student, and open-source builder based in Nepal. He is the founder, lead engineer, and publisher of <strong class="text-white">Sportivo</strong>, an independent digital sports desk built specifically to bridge the gap between global sports schedules and Nepali sports enthusiasts.
        </p>

        <h3 class="text-xl font-bold text-white pt-2">Why Sportivo Was Created</h3>
        <p>
          Following international football leagues (Premier League, La Liga, UEFA Champions League), international cricket series, and NBA basketball from Nepal has traditionally been frustrating. Kickoff times are almost always displayed in foreign time zones (GMT, CET, or EST), forcing Nepali fans to perform mental timezone math for late-night matches. Furthermore, official streaming feeds are often fragmented across multiple broadcasters with geo-restrictions.
        </p>
        <p>
          To solve this problem, Dipesh designed and developed Sportivo. The platform automatically aggregates live fixture data from global sports providers, synchronizes match kickoffs directly into <strong class="text-[#c9f36b]">Nepal Standard Time (NST, UTC+5:45)</strong>, and maintains a resilient multi-server fallback pipeline so supporters never miss kickoff due to offline streaming links.
        </p>

        <h3 class="text-xl font-bold text-white pt-2">Technical Architecture &amp; Engineering Philosophy</h3>
        <p>
          Built with an emphasis on speed, accessibility, and zero-bloat performance, Sportivo leverages modern web standards:
        </p>
        <ul class="list-disc pl-6 space-y-2 text-sm text-slate-300">
          <li><strong class="text-white">Astro SSR &amp; Edge Delivery:</strong> Server-side rendered pages deployed across global edge networks ensure Time To First Byte (TTFB) remains under 150ms even on slower mobile networks in Nepal.</li>
          <li><strong class="text-white">Zero Hydration Overhead:</strong> Static HTML is prioritized for fixtures and search engine bots, with lightweight interactive React islands loaded exclusively where live countdowns and stream switching are needed.</li>
          <li><strong class="text-white">Resilient Stream Pipelining:</strong> A multi-tiered stream resolution system attempts local API proxies before seamlessly failing over to upstream broadcast signals via CORS.</li>
          <li><strong class="text-white">Strict WCAG 2.2 AA Accessibility:</strong> High-contrast typography, keyboard navigation, and semantic ARIA landmarks ensure the desk is accessible to all sports fans.</li>
        </ul>

        <h3 class="text-xl font-bold text-white pt-2">Developer Vision &amp; Ongoing Work</h3>
        <p>
          Beyond Sportivo, Dipesh actively contributes to open-source software, builds educational admission guidance portals, and conducts research in applied machine learning and distributed systems. You can follow his ongoing code releases on GitHub and connect via his official portfolio.
        </p>
      </section>

      <!-- Verified Links (Icons Only) -->
      <section class="mt-12">
        <h2 class="text-2xl font-black text-white">Connect &amp; Social Links</h2>
        <p class="mt-2 text-xs text-slate-300">Official developer profiles and repositories.</p>
        <nav aria-label="Creator social and profile links" class="mt-4 flex flex-wrap items-center gap-3">
          <a
            href="https://www.dipeshsapkota7.com.np/"
            rel="me author external"
            target="_blank"
            title="Personal Portfolio"
            aria-label="Personal Portfolio"
            class="flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-[#111a19] text-slate-300 hover:border-[#c9f36b]/50 hover:bg-[#c9f36b]/10 hover:text-[#c9f36b] hover:scale-105 transition-all shadow-sm"
            itemprop="sameAs"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="2" y1="12" x2="22" y2="12"></line>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
            </svg>
          </a>
          <a
            href="https://github.com/dszae"
            rel="me author external"
            target="_blank"
            title="GitHub (@dszae)"
            aria-label="GitHub (@dszae)"
            class="flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-[#111a19] text-slate-300 hover:border-[#c9f36b]/50 hover:bg-[#c9f36b]/10 hover:text-[#c9f36b] hover:scale-105 transition-all shadow-sm"
            itemprop="sameAs"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
          <a
            href="https://linkedin.com/in/dszae"
            rel="me author external"
            target="_blank"
            title="LinkedIn (@dszae)"
            aria-label="LinkedIn (@dszae)"
            class="flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-[#111a19] text-slate-300 hover:border-[#c9f36b]/50 hover:bg-[#c9f36b]/10 hover:text-[#c9f36b] hover:scale-105 transition-all shadow-sm"
            itemprop="sameAs"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 8.76c-.97 0-1.75-.79-1.75-1.76s.78-1.75 1.75-1.75 1.75.78 1.75 1.75-.78 1.76-1.75 1.76m1.39 9.74v-8.37H5.07v8.37h2.78z"/>
            </svg>
          </a>
          <a
            href="https://facebook.com/dsz.ae"
            rel="me author external"
            target="_blank"
            title="Facebook (@dsz.ae)"
            aria-label="Facebook (@dsz.ae)"
            class="flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-[#111a19] text-slate-300 hover:border-[#c9f36b]/50 hover:bg-[#c9f36b]/10 hover:text-[#c9f36b] hover:scale-105 transition-all shadow-sm"
            itemprop="sameAs"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </nav>
      </section>

      <!-- Sports Category Hubs & Home Link -->
      <section class="mt-14">
        <h2 class="text-2xl font-black text-white">Explore Sportivo Platform</h2>
        <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          <a href="/" class="rounded-xl border border-[#c9f36b]/40 bg-[#111a19] p-4 text-center hover:border-[#c9f36b] hover:bg-[#c9f36b]/10 transition shadow-sm">
            <span class="block text-base font-bold text-[#c9f36b]">Live Fixtures Desk</span>
            <span class="mt-1 block text-xs text-slate-300">Sportivo Home (NST Kickoffs)</span>
          </a>
          <a href="/football/" class="rounded-xl border border-white/10 bg-[#111a19] p-4 text-center hover:border-[#c9f36b]/40 hover:bg-white/5 transition">
            <span class="block text-base font-bold text-white">Football</span>
            <span class="mt-1 block text-xs text-slate-400">Live leagues &amp; streams</span>
          </a>
          <a href="/cricket/" class="rounded-xl border border-white/10 bg-[#111a19] p-4 text-center hover:border-[#c9f36b]/40 hover:bg-white/5 transition">
            <span class="block text-base font-bold text-white">Cricket</span>
            <span class="mt-1 block text-xs text-slate-400">Match schedules &amp; NST</span>
          </a>
          <a href="/basketball/" class="rounded-xl border border-white/10 bg-[#111a19] p-4 text-center hover:border-[#c9f36b]/40 hover:bg-white/5 transition">
            <span class="block text-base font-bold text-white">Basketball</span>
            <span class="mt-1 block text-xs text-slate-400">NBA &amp; global fixtures</span>
          </a>
        </div>
      </section>

      <!-- Frequently Asked Questions (FAQ) with Schema Ranking Boost -->
      <section class="mt-16">
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#e5b94f]">Information &amp; FAQs</p>
        <h2 class="mt-2 text-2xl font-black text-white">Frequently Asked Questions</h2>
        <div class="mt-6 space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-xl border border-white/10 bg-[#111a19] p-5">
              <h3 class="text-base font-bold text-white">{faq.question}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-300">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>