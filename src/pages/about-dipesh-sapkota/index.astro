---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
const title = 'Dipesh Sapkota | Creator of Sportivo';
const description = 'Learn about Dipesh Sapkota, the creator and publisher of Sportivo, a football, cricket, and basketball fixture web application.';
---
<BaseLayout title={title} description={description} canonical="https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/" type="profile">
  <SiteHeader />
  <main class="site-shell min-h-screen text-slate-100"><article class="mx-auto max-w-3xl px-6 pb-20 pt-12 sm:pt-20"><nav aria-label="Breadcrumb" class="text-xs text-slate-500"><a href="/" class="hover:text-[#c9f36b]">Sportivo</a><span class="mx-2">/</span><span>About the creator</span></nav><img src="/dipesh-sapkota-profile.webp" width="220" height="220" alt="Dipesh Sapkota profile mark" class="mt-10 rounded-3xl border border-[#526a38]" /><p class="mt-10 text-xs font-bold uppercase tracking-[0.2em] text-[#e5b94f]">Author and publisher</p><h1 class="mt-3 text-4xl font-black tracking-tight text-white sm:text-6xl">Dipesh Sapkota</h1><p class="mt-4 text-lg font-bold text-[#c9f36b]">Engineering student · AI/ML enthusiast · Builder</p><p class="mt-6 leading-8 text-slate-300">Dipesh Sapkota is the creator and publisher of Sportivo, an independent web application for discovering football, cricket, and basketball fixtures, checking Nepal Standard Time schedules, and reviewing available stream-source information.</p><h2 class="mt-14 text-2xl font-black text-white">Sportivo</h2><p class="mt-4 leading-8 text-slate-300">Sportivo is a focused fixture desk with searchable schedules, local kickoff times, public match URLs, and graceful handling for unavailable stream sources. Fixture availability comes from the upstream provider and is not guaranteed.</p><h2 class="mt-14 text-2xl font-black text-white">Public profiles</h2><nav aria-label="Dipesh Sapkota public profiles" class="mt-5 flex flex-wrap gap-5"><a href="https://www.dipeshsapkota7.com.np/" class="text-[#c9f36b] underline">Portfolio</a><a href="https://github.com/dszae" class="text-[#c9f36b] underline">GitHub</a><a href="https://linkedin.com/in/dszae" class="text-[#c9f36b] underline">LinkedIn</a><a href="https://facebook.com/dsz.ae" class="text-[#c9f36b] underline">Facebook</a></nav></article></main>
</BaseLayout>