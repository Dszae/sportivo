---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { person, personRef, profiles } from '../../lib/identity';

const title = 'About Sportivo’s Creator, Dipesh Sapkota';
const description = 'Dipesh Sapkota, a Computer Engineering student at IOE Thapathali Campus in Kathmandu, Nepal, created Sportivo. Why he built it, how it works, and where to find his profiles.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/';
const profileImageUrl = 'https://sportivo.dipeshsapkota7.com.np/dipesh-sapkota-profile.webp';

const link = (href: string, text: string) =>
  `<a href="${href}" rel="me author" target="_blank" class="text-fg underline underline-offset-4 hover:text-lime">${text}</a>`;

// `answer` is plain text for the FAQ structured data; `answerHtml`, when set, is what the page shows.
const faqs: { question: string; answer: string; answerHtml?: string }[] = [
  {
    question: 'Who created Sportivo?',
    answer: 'Sportivo was created and published by Dipesh Sapkota, a Computer Engineering student at IOE Thapathali Campus in Kathmandu, Nepal.',
    answerHtml: `Sportivo was created and published by ${link(profiles.website, 'Dipesh Sapkota')}, a Computer Engineering student at IOE Thapathali Campus in Kathmandu, Nepal.`,
  },
  {
    question: 'What is Sportivo?',
    answer: 'Sportivo is an independent sports platform that aggregates football, cricket, and basketball fixtures, converts kickoff times to Nepal Standard Time (NST), and displays verified live stream availability from upstream sports providers.',
  },
  {
    question: 'Where can I find the developer profiles and code?',
    answer: 'Dipesh Sapkota’s official website, dipeshsapkota7.com.np, has his full profile and projects. His code is on GitHub (@dszae), his research ID is on ORCID, and you can connect on LinkedIn and Facebook.',
    answerHtml: `${link(profiles.website, 'Dipesh Sapkota')}’s official website, dipeshsapkota7.com.np, has his full profile and projects. His code is on ${link(profiles.github, 'GitHub (@dszae)')}, his research ID is on ${link(profiles.orcid, 'ORCID')}, and you can connect on ${link(profiles.linkedin, 'LinkedIn')} and ${link(profiles.facebook, 'Facebook')}.`,
  },
  {
    question: 'How are kickoff times and streams provided on Sportivo?',
    answer: 'Sportivo processes fixture data from upstream sports APIs and converts timestamps into Nepal Standard Time (UTC+5:45). Live streams and fallbacks are dynamically resolved so fans have fast access to sports broadcasts.',
  },
];

const profileLinks = [
  { href: profiles.website, label: 'Dipesh Sapkota', meta: 'Official website' },
  { href: profiles.linkedin, label: 'LinkedIn', meta: 'dipeshsapkota7' },
  { href: profiles.github, label: 'GitHub', meta: '@dszae' },
  { href: profiles.orcid, label: 'ORCID', meta: '0009-0001-7595-5114' },
  { href: profiles.wikidata, label: 'Wikidata', meta: 'Q141595522' },
  { href: profiles.facebook, label: 'Facebook', meta: 'dsz.ae' },
];

// Bump when the page content changes.
const DATE_MODIFIED = '2026-11-18';
const DATE_MODIFIED_LABEL = '18 November 2026';

// This page supports the canonical entity page (the main website): it carries the same
// Person (shared @id, url and description) as its main entity, defined once.
const profilePageSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': `${canonical}#webpage`,
  'url': canonical,
  'name': title,
  'dateCreated': '2026-01-01',
  'dateModified': DATE_MODIFIED,
  'isPartOf': { '@type': 'WebSite', '@id': 'https://sportivo.dipeshsapkota7.com.np/#website' },
  'primaryImageOfPage': {
    '@type': 'ImageObject',
    '@id': `${canonical}#profile-image`,
    'url': profileImageUrl,
    'contentUrl': profileImageUrl,
    'width': 627,
    'height': 627,
    'caption': 'Dipesh Sapkota, creator of Sportivo',
    'creditText': 'Dipesh Sapkota',
    'creator': personRef,
    'copyrightNotice': 'Copyright 2026 Dipesh Sapkota',
    'license': profiles.website,
    'acquireLicensePage': profiles.website
  },
  'mainEntity': person,
  'breadcrumb': {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Sportivo Home',
        'item': 'https://sportivo.dipeshsapkota7.com.np/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'Dipesh Sapkota (Creator)',
        'item': canonical
      }
    ]
  }
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': faqs.map((faq) => ({
    '@type': 'Question',
    'name': faq.question,
    'acceptedAnswer': {
      '@type': 'Answer',
      'text': faq.answer
    }
  }))
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  type="profile"
  image="/dipesh-sapkota-profile.webp"
  imageAlt="Dipesh Sapkota - Creator and developer of Sportivo"
  imageWidth={627}
  imageHeight={627}
  imageType="image/webp"
  person={false}
  keywords="Dipesh Sapkota, Dipesh, dszae, Sportivo creator, Dipesh Sapkota Nepal, software developer Nepal, engineering student Nepal, Sportivo publisher"
>
  <Fragment slot="head">
    <link rel="preload" as="image" href="/dipesh-sapkota-profile.webp" type="image/webp" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(profilePageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </Fragment>

  <SiteHeader activeCategory="creator" />

  <main class="site-shell min-h-screen">
    <article class="mx-auto max-w-3xl px-4 pb-24 pt-8 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-fg-3">
        <a href="/" class="transition-colors duration-fast ease-out hover:text-fg">Home</a>
        <span aria-hidden="true">/</span>
        <span class="text-fg-2" aria-current="page">About</span>
      </nav>

      <figure class="mt-10 flex flex-col items-start gap-6 sm:flex-row sm:items-center">
        <img
          src="/dipesh-sapkota-profile.webp"
          width="627"
          height="627"
          alt="Dipesh Sapkota, creator and publisher of Sportivo"
          title="Dipesh Sapkota"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="h-32 w-32 rounded-2xl border border-line object-cover"
        />
        <figcaption>
          <p class="eyebrow">Creator of Sportivo</p>
          <h1 class="mt-2 text-4xl font-medium tracking-[-0.02em] text-fg sm:text-5xl">Dipesh Sapkota</h1>
          <p class="mt-2 text-base text-fg-2">Computer Engineering student, IOE Thapathali Campus, Kathmandu</p>
          <p class="mt-1 text-xs text-fg-3">Updated <time datetime={DATE_MODIFIED}>{DATE_MODIFIED_LABEL}</time></p>
        </figcaption>
      </figure>

      <section class="mt-12 flex flex-col gap-4 border-y border-line py-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="text-base text-fg">Sportivo</p>
          <p class="mt-1 text-sm text-fg-2">Football, cricket and basketball fixtures, scores and streams in Nepal Standard Time</p>
        </div>
        <a href="/" class="btn btn-secondary shrink-0">Open fixtures</a>
      </section>

      <section class="mt-12 space-y-6 text-base leading-7 text-fg-2">
        <h2 class="text-2xl font-medium text-fg">About</h2>
        <p>
          <a href={profiles.website} rel="author" class="text-fg underline underline-offset-4 hover:text-lime">Dipesh Sapkota</a>
          is a Computer Engineering student at IOE Thapathali Campus in Kathmandu, Nepal, exploring artificial intelligence, machine learning, embedded systems and motion design. He founded, built and publishes <strong class="font-medium text-fg">Sportivo</strong>, an independent sports desk that brings global fixtures to fans in Nepal, in their own time zone.
        </p>
        <p>
          This page covers his work on Sportivo. His full profile, other projects and contact details are on
          <a href={profiles.website} rel="author" class="text-fg underline underline-offset-4 hover:text-lime">Dipesh Sapkota's official website</a>.
        </p>

        <h3 class="pt-2 text-xl font-medium text-fg">Why Sportivo exists</h3>
        <p>
          Following the Premier League, La Liga, the Champions League, international cricket and the NBA from Nepal has always meant converting kickoff times from GMT, CET or EST by hand, and hunting for streams scattered across broadcasters with geo-restrictions.
        </p>
        <p>
          Sportivo pulls fixture data from global providers, converts every kickoff to <span class="clock text-fg">Nepal Standard Time, UTC+5:45</span>, and keeps several stream servers per match so a dead link does not mean a missed kickoff.
        </p>

        <h3 class="pt-2 text-xl font-medium text-fg">How it is built</h3>
        <ul class="list-disc space-y-2 pl-6 text-[15px]">
          <li><strong class="font-medium text-fg">Astro on the edge.</strong> Server-rendered pages served from edge networks, so first byte stays fast on mobile networks in Nepal.</li>
          <li><strong class="font-medium text-fg">Islands only where needed.</strong> Fixtures are plain HTML; React loads only for live countdowns, the player and the watchlist.</li>
          <li><strong class="font-medium text-fg">Stream fallback.</strong> Local API proxies are tried first, then upstream broadcast signals.</li>
          <li><strong class="font-medium text-fg">Accessible by default.</strong> High-contrast type, keyboard navigation and semantic landmarks.</li>
        </ul>

        <h3 class="pt-2 text-xl font-medium text-fg">Elsewhere</h3>
        <p>
          Beyond Sportivo, Dipesh built IOE Admission Hub and Git Visualizer, and has more than four years of freelance work as a video editor and motion graphics designer. Known online as dszae.
        </p>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-medium text-fg">Links</h2>
        <ul class="mt-4 divide-y divide-line" aria-label="Dipesh Sapkota's profiles">
          {profileLinks.map((p) => (
            <li>
              <a href={p.href} rel="me author" target="_blank" class="row -mx-4 h-12 py-0 text-sm text-fg">
                <span class="flex-1">{p.label}</span><span class="meta">{p.meta}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl font-medium text-fg">On Sportivo</h2>
        <ul class="mt-4 divide-y divide-line">
          <li><a href="/" class="row -mx-4 h-12 py-0 text-sm text-fg"><span class="flex-1">All fixtures</span><span class="meta">Home</span></a></li>
          <li><a href="/npl/" class="row -mx-4 h-12 py-0 text-sm text-fg"><span class="flex-1">NPL 2026</span><span class="meta">Cricket, Nepal</span></a></li>
          <li><a href="/football/" class="row -mx-4 h-12 py-0 text-sm text-fg"><span class="flex-1">Football</span><span class="meta">Leagues and streams</span></a></li>
          <li><a href="/cricket/" class="row -mx-4 h-12 py-0 text-sm text-fg"><span class="flex-1">Cricket</span><span class="meta">Schedules in NST</span></a></li>
          <li><a href="/basketball/" class="row -mx-4 h-12 py-0 text-sm text-fg"><span class="flex-1">Basketball</span><span class="meta">NBA and more</span></a></li>
        </ul>
      </section>

      <section class="mt-16 border-t border-line pt-12">
        <p class="eyebrow">Questions</p>
        <h2 class="mt-3 text-2xl font-medium text-fg">Common questions</h2>
        <dl class="mt-6 divide-y divide-line">
          {faqs.map((faq) => (
            <div class="py-5 first:pt-0 last:pb-0">
              <dt class="text-base font-medium text-fg">{faq.question}</dt>
              {faq.answerHtml ? (
                <dd class="mt-2 text-sm leading-6 text-fg-2" set:html={faq.answerHtml} />
              ) : (
                <dd class="mt-2 text-sm leading-6 text-fg-2">{faq.answer}</dd>
              )}
            </div>
          ))}
        </dl>
      </section>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>
