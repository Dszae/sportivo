---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const title = 'Privacy Policy — Sportivo Live Sports Desk & Mobile App';
const description = 'Privacy Policy for Sportivo sports fixture desk and mobile application by Dipesh Sapkota. Outlining device permissions, local preferences, and notification delivery.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/privacy/';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
>
  <SiteHeader />

  <main class="mx-auto max-w-4xl px-4 py-12 sm:px-6 lg:px-8 text-slate-200">
    <div class="mb-10 text-center">
      <span class="rounded-full bg-[#c9f36b]/15 border border-[#c9f36b]/30 px-3 py-1 text-xs font-bold text-[#c9f36b] uppercase tracking-wider">
        Official Store Compliance
      </span>
      <h1 class="mt-4 text-3xl font-black text-white sm:text-4xl">
        Privacy Policy for Sportivo
      </h1>
      <p class="mt-2 text-sm text-slate-400">
        Effective Date: October 28, 2026 · Created by Dipesh Sapkota
      </p>
    </div>

    <div class="space-y-8 text-sm leading-relaxed bg-[#111a19] p-6 sm:p-8 rounded-2xl border border-white/10 shadow-xl">
      <section>
        <h2 class="text-lg font-bold text-white mb-2">1. Overview</h2>
        <p>
          Sportivo ("we", "our", or "the App") is developed and maintained by Dipesh Sapkota. Sportivo provides live sports match desks, schedules, scores, and broadcast links for Football, Nepal Premier League (NPL 2026), Cricket, and Basketball in Nepal Standard Time (NST). We respect your privacy and are committed to protecting your personal information.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">2. Information Collection & Usage</h2>
        <p class="mb-2">Sportivo is designed with privacy by default. We do not require account registration or collect sensitive personal data such as your name, phone number, or passwords:</p>
        <ul class="list-disc pl-5 space-y-1.5 text-slate-300">
          <li><strong>Watchlist &amp; Favorites:</strong> Your followed teams and starred fixtures are stored locally on your device via AsyncStorage / LocalStorage.</li>
          <li><strong>Device Notifications:</strong> If you grant notification permission, an anonymous device push token (via Google Firebase FCM / Web Push) is generated solely to deliver kickoff reminders (5-minute and 30-minute alerts) and live score updates for your followed teams.</li>
          <li><strong>Haptic Feedback:</strong> The mobile app requests vibration access strictly to provide physical tactile pulses during live match moments (goals and wickets).</li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">3. Third-Party Services</h2>
        <p>
          To deliver live broadcasting feeds and match data, the application interacts with sports data providers and CDN hosts. These services receive standard HTTP request headers (IP address, user-agent) necessary to serve streaming chunks and fixture scores.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">4. Data Sharing &amp; Monetization</h2>
        <p>
          We do <strong>not</strong> sell, rent, monetize, or share your device data, notification tokens, or usage patterns with any data brokers, third-party advertisers, or marketing agencies.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">5. User Control &amp; Data Deletion</h2>
        <p>
          You have full control over your data at any time:
        </p>
        <ul class="list-disc pl-5 space-y-1.5 text-slate-300 mt-2">
          <li>You can disable push notifications at any time in the app settings or via your Android/iOS system settings.</li>
          <li>You can clear your entire watchlist and local preferences in 1 tap inside the "My Watchlist" desk.</li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-bold text-white mb-2">6. Developer Contact Information</h2>
        <p>
          If you have any questions or feedback regarding this Privacy Policy or Sportivo's data practices, please contact the developer:
        </p>
        <div class="mt-3 p-4 rounded-xl bg-black/40 border border-white/10">
          <p class="font-bold text-white">Dipesh Sapkota</p>
          <p class="text-slate-300">Lead Developer · Sportivo Live Sports Desk</p>
          <p class="text-[#c9f36b] mt-1">Email: <a href="mailto:dipeshsapkota7@gmail.com" class="hover:underline">dipeshsapkota7@gmail.com</a></p>
          <p class="text-slate-400">Website: <a href="https://www.dipeshsapkota7.com.np/" target="_blank" rel="noopener noreferrer" class="hover:underline">https://www.dipeshsapkota7.com.np/</a></p>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
