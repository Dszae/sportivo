---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const title = 'Privacy Policy — Sportivo Live Sports Desk & Mobile App';
const description = 'Privacy Policy for Sportivo sports fixture desk and mobile application by Dipesh Sapkota. Outlining device permissions, local preferences, and notification delivery.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/privacy/';
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
>
  <SiteHeader />

  <main class="site-shell min-h-screen">
    <article class="mx-auto max-w-3xl px-4 pb-24 pt-8 sm:px-6 lg:px-8">
      <p class="eyebrow">Privacy</p>
      <h1 class="mt-3 text-4xl font-medium tracking-[-0.02em] text-fg sm:text-5xl">Privacy policy</h1>
      <p class="clock mt-4 text-sm text-fg-2">Effective October 28, 2026</p>

      <div class="mt-12 space-y-10 text-[15px] leading-7 text-fg-2">
        <section>
          <h2 class="text-xl font-medium text-fg">Overview</h2>
          <p class="mt-3">
            Sportivo is developed and maintained by Dipesh Sapkota. It provides fixtures, scores and broadcast links for football, the Nepal Premier League, cricket and basketball in Nepal Standard Time. We respect your privacy and collect as little as possible.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-medium text-fg">What is stored</h2>
          <p class="mt-3">There is no account. We do not collect your name, phone number or passwords.</p>
          <ul class="mt-3 list-disc space-y-2 pl-6">
            <li><strong class="font-medium text-fg">Watchlist.</strong> Followed teams and starred fixtures are stored on your device, in local storage.</li>
            <li><strong class="font-medium text-fg">Notifications.</strong> If you allow them, an anonymous push token (Firebase or Web Push) is created only to deliver kickoff reminders and live score updates for the teams you follow.</li>
            <li><strong class="font-medium text-fg">Vibration.</strong> The mobile app uses vibration only for live moments such as goals and wickets.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-medium text-fg">Third parties</h2>
          <p class="mt-3">
            To show live feeds and match data, the app talks to sports data providers and CDN hosts. They receive the standard request headers (IP address, user agent) needed to serve stream chunks and scores.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-medium text-fg">Sharing</h2>
          <p class="mt-3">
            We do not sell, rent or share device data, notification tokens or usage with data brokers, advertisers or marketing agencies.
          </p>
        </section>

        <section>
          <h2 class="text-xl font-medium text-fg">Your control</h2>
          <ul class="mt-3 list-disc space-y-2 pl-6">
            <li>Turn off push notifications in the app or in your system settings at any time.</li>
            <li>Clear your watchlist and preferences in one tap from the Watchlist page.</li>
          </ul>
        </section>

        <section>
          <h2 class="text-xl font-medium text-fg">Contact</h2>
          <p class="mt-3">Questions about this policy go to the developer.</p>
          <dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2">
            <div><dt class="meta">Developer</dt><dd class="mt-1 text-fg">Dipesh Sapkota</dd></div>
            <div><dt class="meta">Email</dt><dd class="mt-1"><a href="mailto:dipeshsapkota7@gmail.com" class="text-fg underline underline-offset-4">dipeshsapkota7@gmail.com</a></dd></div>
            <div><dt class="meta">Website</dt><dd class="mt-1"><a href="https://www.dipeshsapkota7.com.np/" target="_blank" rel="noopener noreferrer" class="text-fg underline underline-offset-4">dipeshsapkota7.com.np</a></dd></div>
          </dl>
        </section>
      </div>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>

