---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const title = 'Download Sportivo App for Android — NPL 2026 Live Streams & Scores | Sportivo';
const description = 'Download the official Sportivo Android app (APK). Watch Nepal Premier League (NPL 2026) in zero-delay 1080p, follow real-time live ball-by-ball scoreboards, and get kickoff alerts in Nepal Standard Time.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/download/';
---

<BaseLayout title={title} description={description} canonical={canonical}>
  <SiteHeader />

  <main class="relative mx-auto flex-1 max-w-4xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Hero Box -->
    <div class="relative overflow-hidden rounded-2xl border border-line bg-ink-950 p-6 sm:p-10 text-center shadow-float">
      <!-- Glow effect -->
      <div class="pointer-events-none absolute -top-24 left-1/2 -translate-x-1/2 h-64 w-96 rounded-full bg-lime/10 blur-3xl"></div>

      <!-- App Icon -->
      <div class="relative mx-auto mb-6 flex h-20 w-20 items-center justify-center rounded-2xl border border-line bg-ink-900 shadow-card">
        <span class="h-4 w-4 rounded-full bg-lime shadow-[0_0_12px_rgba(201,243,107,0.8)]"></span>
      </div>

      <div class="inline-flex items-center gap-2 rounded-full border border-lime/30 bg-lime/10 px-3 py-1 text-xs font-semibold text-lime mb-4">
        <span>⚡ Sportivo Native Android App</span>
        <span class="text-fg-3">•</span>
        <span>v1.1.7</span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-fg">
        Get Sportivo on Android
      </h1>
      <p class="mx-auto mt-3 max-w-xl text-base text-fg-2">
        Zero-delay NPL 2026 live streaming, real-time ground telemetry scoreboards, and instant Nepal Standard Time (NST) match kickoff alerts.
      </p>

      <!-- Primary Action Buttons -->
      <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/download/sportivo.apk"
          class="btn btn-primary w-full sm:w-auto px-8 py-3.5 text-base font-bold shadow-glow"
          download="sportivo.apk"
        >
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <path d="m7 10 5 5 5-5M12 15V3" />
          </svg>
          <span>Download Sportivo APK (Release)</span>
        </a>

        <a
          href="https://github.com/Dszae/sportivo/releases/latest"
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary w-full sm:w-auto px-6 py-3.5 text-sm font-semibold"
        >
          <span>View on GitHub Releases ↗</span>
        </a>
      </div>

      <p class="mt-3 text-xs text-fg-3">
        Direct install • 100% Free & Open Source • Android 8.0 or newer
      </p>
    </div>

    <!-- Features Grid -->
    <div class="mt-12 grid grid-cols-1 gap-4 sm:grid-cols-3">
      <div class="rounded-xl border border-line bg-ink-950 p-5">
        <div class="mb-3 text-2xl">🏏</div>
        <h3 class="font-bold text-fg text-base">Ground Telemetry Scorer</h3>
        <p class="mt-1 text-xs text-fg-2 leading-relaxed">
          Ball-by-ball updates directly from TU Ground with live CRR, RRR, active batter run rates, and bowler statistics.
        </p>
      </div>

      <div class="rounded-xl border border-line bg-ink-950 p-5">
        <div class="mb-3 text-2xl">📺</div>
        <h3 class="font-bold text-fg text-base">In-App Shaka Player</h3>
        <p class="mt-1 text-xs text-fg-2 leading-relaxed">
          Built-in Widevine DRM hardware acceleration for zero-delay NetTV Edge & LB DASH streams in 1080p HD.
        </p>
      </div>

      <div class="rounded-xl border border-line bg-ink-950 p-5">
        <div class="mb-3 text-2xl">⚡</div>
        <h3 class="font-bold text-fg text-base">In-App Background Updates</h3>
        <p class="mt-1 text-xs text-fg-2 leading-relaxed">
          Whenever a new update is released, Sportivo downloads it in the background and prompts you with a 1-tap install.
        </p>
      </div>
    </div>

    <!-- Installation Steps Guide -->
    <div class="mt-12 rounded-2xl border border-line bg-ink-950 p-6 sm:p-8">
      <h2 class="text-xl font-bold text-fg">How to Install on Android</h2>
      <div class="mt-6 space-y-4">
        <div class="flex items-start gap-4">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-lime/20 font-bold text-lime text-xs">
            1
          </div>
          <div>
            <h4 class="text-sm font-semibold text-fg">Download the APK file</h4>
            <p class="text-xs text-fg-2 mt-0.5">
              Tap the <strong>Download Sportivo APK</strong> button above. If Chrome or your browser warns that the file might be harmful, tap <strong>Download anyway</strong>.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-lime/20 font-bold text-lime text-xs">
            2
          </div>
          <div>
            <h4 class="text-sm font-semibold text-fg">Allow installation from browser</h4>
            <p class="text-xs text-fg-2 mt-0.5">
              When prompted by Android, go to <em>Settings &gt; Allow from this source</em> to permit package installation.
            </p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-lime/20 font-bold text-lime text-xs">
            3
          </div>
          <div>
            <h4 class="text-sm font-semibold text-fg">Open &amp; Enjoy</h4>
            <p class="text-xs text-fg-2 mt-0.5">
              Tap <strong>Install</strong>. Once installed, open Sportivo for instant live NPL match scores and streams!
            </p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
