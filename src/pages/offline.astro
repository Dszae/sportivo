---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const title = 'Offline — Sportivo';
const description = 'You are currently offline. Sportivo requires an active internet connection for real-time live match scores and authorized streams.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/offline/';
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
>
  <SiteHeader />

  <main class="site-shell min-h-[70vh] flex items-center justify-center text-slate-100 px-6 py-16">
    <div class="max-w-md w-full text-center rounded-3xl border border-white/10 bg-[#111a19] p-8 shadow-2xl">
      <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-400">
        <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="1" y1="1" x2="23" y2="23"></line>
          <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"></path>
          <path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"></path>
          <path d="M10.71 5.05A16 16 0 0 1 22.58 9"></path>
          <path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"></path>
          <path d="M8.53 16.11a6 6 0 0 1 6.95 0"></path>
          <line x1="12" y1="20" x2="12.01" y2="20"></line>
        </svg>
      </div>

      <span class="text-[10px] font-black uppercase tracking-widest text-[#e5b94f]">Connection Status</span>
      <h1 class="text-2xl font-black text-white mt-1">You're Offline</h1>
      
      <p class="mt-3 text-sm leading-relaxed text-slate-400">
        Sportivo needs an active connection to aggregate live scores, real-time fixture updates, and authorized stream servers.
      </p>

      <div class="mt-6 flex flex-col gap-2.5">
        <button
          onclick="window.location.reload()"
          class="w-full rounded-xl bg-[#c9f36b] py-2.5 text-xs font-black text-[#0a1110] hover:bg-white transition"
        >
          Check Connection &amp; Retry
        </button>
        <a
          href="/"
          class="w-full rounded-xl border border-white/10 bg-white/5 py-2.5 text-xs font-bold text-slate-300 hover:text-white transition"
        >
          Return to Cached Home
        </a>
      </div>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
