---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import NplSchedule from '../../components/NplSchedule';
import { getCalibratedNplFixtures } from '../../lib/data/nplData';
import { slugify } from '../../lib/sportivo';

const now = Date.now();
const allFixtures = getCalibratedNplFixtures(now);

// Check if any match is actively LIVE right now
const liveFixture = allFixtures.find((m) => m.status === 'LIVE');

// Live stream URL targeting the match happening right now
const liveSlug = liveFixture ? slugify(`${liveFixture.homeTeam} vs ${liveFixture.awayTeam}`) : '';
const liveStreamUrl = liveSlug ? `/cricket/match/${encodeURIComponent(liveSlug)}/` : '';

function formatKathmanduTime(timestamp: number): string {
  try {
    return (
      new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Kathmandu',
        hour: 'numeric',
        minute: '2-digit',
        hour12: true,
      }).format(new Date(timestamp)) + ' NST'
    );
  } catch {
    return '12:30 PM NST';
  }
}

const title = 'NPL Live Match & Schedule — Nepal Premier League 2026 Live Scores & Streams | Sportivo';
const description = 'Watch NPL live match online today! Follow Nepal Premier League 2026 ball-by-ball live scores, team standings, full match schedule in Nepal Standard Time (NST), and authorized high-definition live streams on Sportivo.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/npl/';

const nplFaqs = [
  {
    question: 'Where is the Nepal Premier League (NPL) 2026 being held?',
    answer: 'All Nepal Premier League matches are hosted at the Tribhuvan University International Cricket Ground in Kirtipur, Kathmandu, Nepal.',
  },
  {
    question: 'What time are NPL matches played in Nepal Standard Time (NST)?',
    answer: 'Day matches kick off at 12:30 PM NST (06:45 UTC), while evening / afternoon matches start at 5:00 PM NST (11:15 UTC).',
  },
  {
    question: 'Which teams are participating in NPL 2026?',
    answer: 'Eight franchise teams compete in the NPL: Biratnagar Kings, Chitwan Rhinos, Janakpur Bolts, Karnali Yaks, Kathmandu Gurkhas, Lumbini Lions, Pokhara Avengers, and Sudurpaschim Royals.',
  },
  {
    question: 'Where can I watch NPL live streams in Nepal and internationally?',
    answer: 'In Nepal, official broadcasts are televised on Action Sports HD and streamed via DishHome and NetTV. International coverage is provided via licensed digital feeds and YouTube official embeds when available.',
  },
  {
    question: 'How does Sportivo calculate today’s and upcoming NPL matches?',
    answer: 'Sportivo synchronizes fixtures directly with official tournament data and calculates dates and times strictly in Asia/Kathmandu (UTC+5:45), ensuring accurate match tracking without timezone discrepancies.',
  },
];

const nplJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SportsEvent',
      '@id': `${canonical}#event`,
      'name': 'Nepal Premier League 2026',
      'description': description,
      'url': canonical,
      'startDate': '2026-10-26T11:15:00+05:45',
      'endDate': '2026-11-21T21:00:00+05:45',
      'location': {
        '@type': 'Place',
        'name': 'Tribhuvan University International Cricket Ground',
        'address': {
          '@type': 'PostalAddress',
          'addressLocality': 'Kirtipur',
          'addressRegion': 'Kathmandu',
          'addressCountry': 'NP'
        }
      },
      'organizer': {
        '@type': 'SportsOrganization',
        'name': 'Nepal Premier League',
        'url': 'https://nepalpremierleague.org'
      },
      'broadcaster': [
        {
          '@type': 'BroadcastService',
          'name': 'Sportivo Live Sports Desk',
          'url': 'https://sportivo.dipeshsapkota7.com.np/npl/',
          'inLanguage': 'en-NP'
        }
      ],
      'offers': {
        '@type': 'Offer',
        'url': canonical,
        'price': '0',
        'priceCurrency': 'NPR',
        'availability': 'https://schema.org/InStock'
      }
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sportivo.dipeshsapkota7.com.np/#website',
      'url': 'https://sportivo.dipeshsapkota7.com.np/',
      'name': 'Sportivo',
      'publisher': {
        '@type': 'Person',
        '@id': 'https://www.dipeshsapkota7.com.np/#person',
        'name': 'Dipesh Sapkota',
        'url': 'https://www.dipeshsapkota7.com.np/'
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Sportivo Home',
          'item': 'https://sportivo.dipeshsapkota7.com.np/'
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Cricket Desk',
          'item': 'https://sportivo.dipeshsapkota7.com.np/cricket/'
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': 'NPL 2026 Live Match & Schedule',
          'item': canonical
        }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      'mainEntity': nplFaqs.map((faq) => ({
        '@type': 'Question',
        'name': faq.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords="NPL live match, npl live match, watch npl live, npl live stream, Nepal Premier League live, NPL 2026, NPL schedule, NPL live scores, Sportivo NPL, Biratnagar Kings, Chitwan Rhinos, Janakpur Bolts, Karnali Yaks, Kathmandu Gurkhas, Lumbini Lions, Pokhara Avengers, Sudurpaschim Royals, TU Cricket Ground, Action Sports HD, NetTV, Dipesh Sapkota"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(nplJsonLd)} />
  </Fragment>

  <SiteHeader activeCategory="npl" />

  <main class="site-shell min-h-screen text-slate-100">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8 pb-24">
      {/* Breadcrumb Navigation */}
      <nav aria-label="Breadcrumb" class="mb-6 flex items-center gap-2 text-xs text-slate-400">
        <a href="/" class="hover:text-white transition">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/cricket/" class="hover:text-white transition">Cricket</a>
        <span aria-hidden="true">/</span>
        <span class="text-[#c9f36b] font-semibold" aria-current="page">NPL 2026</span>
      </nav>

      {/* Featured Live Match Banner: Prominently highlights match happening right now with "Watch Live" taking user to the streaming page */}
      {liveFixture && (
        <section class="mb-10 overflow-hidden rounded-3xl border border-red-500/50 bg-gradient-to-br from-[#1c0808] via-[#0d1413] to-[#0a0f0e] p-6 sm:p-8 shadow-2xl ring-1 ring-red-500/30">
          <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/10 pb-4 mb-6">
            <div class="flex items-center gap-2.5">
              <span class="relative flex h-3.5 w-3.5">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75"></span>
                <span class="relative inline-flex h-3.5 w-3.5 rounded-full bg-red-500"></span>
              </span>
              <span class="text-xs font-black uppercase tracking-wider text-red-400">Match Happening Right Now</span>
            </div>
            <span class="rounded-full border border-red-500/30 bg-red-500/10 px-3 py-1 text-xs font-black text-red-300">
              Match {liveFixture.matchNumber} · TU International Cricket Ground
            </span>
          </div>

          <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
            <div class="flex-1">
              <div class="flex items-center gap-3">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-red-600 px-3 py-1 text-xs font-black uppercase tracking-wider text-white shadow-sm">
                  <span class="h-2 w-2 animate-ping rounded-full bg-white"></span>
                  LIVE ON AIR
                </span>
                <span class="text-xs font-bold text-slate-300">Nepal Premier League 2026</span>
              </div>

              <h2 class="mt-3 text-2xl sm:text-4xl font-black text-white tracking-tight">
                {liveFixture.homeTeam} <span class="text-red-500 font-light text-xl sm:text-2xl">vs</span> {liveFixture.awayTeam}
              </h2>

              <div class="mt-4 flex flex-wrap items-center gap-3 text-xs text-slate-300">
                <span class="flex items-center gap-1.5 rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 font-bold text-white">
                  <span>📅 Today</span>
                  <span>•</span>
                  <span>Kickoff: {formatKathmanduTime(liveFixture.timestamp)}</span>
                </span>
                {liveFixture.homeScore && (
                  <span class="rounded-lg border border-[#c9f36b]/30 bg-[#c9f36b]/10 px-3 py-1.5 font-mono text-sm font-black text-[#c9f36b]">
                    Live Score: {liveFixture.homeScore}
                  </span>
                )}
                <span class="text-slate-400">Broadcasting live on Action Sports HD &amp; Multi-Server Digital Stream</span>
              </div>
            </div>

            <div class="shrink-0 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
              <a
                href={liveStreamUrl}
                class="inline-flex items-center justify-center gap-2 rounded-2xl bg-red-600 hover:bg-red-500 px-7 py-4 text-sm font-black text-white shadow-xl shadow-red-950/60 transition-all hover:scale-105 active:scale-95"
              >
                <span class="h-2.5 w-2.5 rounded-full bg-white animate-pulse"></span>
                <span>Watch Live Stream ⚡</span>
              </a>
            </div>
          </div>
        </section>
      )}

      {/* Main NPL Schedule Desk Component */}
      <section class="rounded-3xl border border-white/[0.08] bg-[#0a0f0e]/60 p-6 sm:p-8 lg:p-10 backdrop-blur-sm shadow-2xl shadow-black/40">
        <NplSchedule client:load />
      </section>

      {/* NPL Tournament Overview & Info */}
      <section class="mt-16 border-t border-white/5 pt-12">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-[#e5b94f]">Venue Information</span>
            <h3 class="mt-2 text-base font-bold text-white">TU International Cricket Ground</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-400">
              Situated in Kirtipur, Kathmandu, the TU Cricket Ground is Nepal's premier international cricket facility hosting all 32 matches of NPL 2026.
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-[#e5b94f]">Match Times (NST)</span>
            <h3 class="mt-2 text-base font-bold text-white">12:30 PM &amp; 5:00 PM Kickoffs</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-400">
              Doubleheader matchdays feature an afternoon game at 12:30 PM NST followed by a twilight match under lights at 5:00 PM NST.
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-sm">
            <span class="text-xs font-bold uppercase tracking-wider text-[#e5b94f]">Broadcasting Rights</span>
            <h3 class="mt-2 text-base font-bold text-white">Action Sports HD &amp; NetTV</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-400">
              Authorized broadcast signals in Nepal are distributed via Action Sports HD, NetTV, and DishHome with verified streaming embed integration.
            </p>
          </div>
        </div>
      </section>

      {/* FAQs for NPL */}
      <section class="mt-16 border-t border-white/5 pt-12" aria-labelledby="npl-faq-heading">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#e5b94f]">Information &amp; Guidance</p>
          <h2 id="npl-faq-heading" class="mt-2 text-2xl font-black tracking-tight text-white sm:text-3xl">
            Nepal Premier League FAQ
          </h2>
          <p class="mt-2 text-sm text-slate-300">
            Everything you need to know about NPL 2026 fixtures, timings, and streaming coverage.
          </p>
        </div>

        <div class="mt-8 space-y-4">
          {nplFaqs.map((faq) => (
            <div class="rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-sm">
              <h3 class="text-base font-bold text-white">{faq.question}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-300">{faq.answer}</p>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>

