---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import NplSchedule from '../../components/NplSchedule';

const title = 'NPL Live Match & Schedule — Nepal Premier League 2026 Live Scores & Streams | Sportivo';
const description = 'Watch NPL live match online today! Follow Nepal Premier League 2026 ball-by-ball live scores, team standings, full match schedule in Nepal Standard Time (NST), and authorized high-definition live streams on Sportivo.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/npl/';

const nplFaqs = [
  {
    question: 'Where is the Nepal Premier League (NPL) 2026 being held?',
    answer: 'All Nepal Premier League matches are hosted at the Tribhuvan University International Cricket Ground in Kirtipur, Kathmandu, Nepal.',
  },
  {
    question: 'What time are NPL matches played in Nepal Standard Time (NST)?',
    answer: 'Day matches kick off at 12:30 PM NST (06:45 UTC), while evening / afternoon matches start at 5:00 PM NST (11:15 UTC).',
  },
  {
    question: 'Which teams are participating in NPL 2026?',
    answer: 'Eight franchise teams compete in the NPL: Biratnagar Kings, Chitwan Rhinos, Janakpur Bolts, Karnali Yaks, Kathmandu Gurkhas, Lumbini Lions, Pokhara Avengers, and Sudurpaschim Royals.',
  },
  {
    question: 'Where can I watch NPL live streams in Nepal and internationally?',
    answer: 'In Nepal, official broadcasts are televised on Action Sports HD and streamed via DishHome and NetTV. International coverage is provided via licensed digital feeds and YouTube official embeds when available.',
  },
  {
    question: 'How does Sportivo calculate today’s and upcoming NPL matches?',
    answer: 'Sportivo synchronizes fixtures directly with official tournament data and calculates dates and times strictly in Asia/Kathmandu (UTC+5:45), ensuring accurate match tracking without timezone discrepancies.',
  },
];

const nplJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SportsEvent',
      '@id': `${canonical}#event`,
      'name': 'Nepal Premier League 2026',
      'description': description,
      'url': canonical,
      'startDate': '2026-10-26T11:15:00+05:45',
      'endDate': '2026-11-21T21:00:00+05:45',
      'location': {
        '@type': 'Place',
        'name': 'Tribhuvan University International Cricket Ground',
        'address': {
          '@type': 'PostalAddress',
          'addressLocality': 'Kirtipur',
          'addressRegion': 'Kathmandu',
          'addressCountry': 'NP'
        }
      },
      'organizer': {
        '@type': 'SportsOrganization',
        'name': 'Nepal Premier League',
        'url': 'https://nepalpremierleague.org'
      },
      'broadcaster': [
        {
          '@type': 'BroadcastService',
          'name': 'Sportivo Live Sports Desk',
          'url': 'https://sportivo.dipeshsapkota7.com.np/npl/',
          'inLanguage': 'en-NP'
        }
      ],
      'offers': {
        '@type': 'Offer',
        'url': canonical,
        'price': '0',
        'priceCurrency': 'NPR',
        'availability': 'https://schema.org/InStock'
      }
    },
    {
      '@type': 'WebSite',
      '@id': 'https://sportivo.dipeshsapkota7.com.np/#website',
      'url': 'https://sportivo.dipeshsapkota7.com.np/',
      'name': 'Sportivo',
      'publisher': {
        '@type': 'Person',
        '@id': 'https://www.dipeshsapkota7.com.np/#person',
        'name': 'Dipesh Sapkota',
        'url': 'https://www.dipeshsapkota7.com.np/'
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Sportivo Home',
          'item': 'https://sportivo.dipeshsapkota7.com.np/'
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Cricket Desk',
          'item': 'https://sportivo.dipeshsapkota7.com.np/cricket/'
        },
        {
          '@type': 'ListItem',
          'position': 3,
          'name': 'NPL 2026 Live Match & Schedule',
          'item': canonical
        }
      ]
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      'mainEntity': nplFaqs.map((faq) => ({
        '@type': 'Question',
        'name': faq.question,
        'acceptedAnswer': {
          '@type': 'Answer',
          'text': faq.answer,
        },
      })),
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords="NPL live match, npl live match, watch npl live, npl live stream, Nepal Premier League live, NPL 2026, NPL schedule, NPL live scores, Sportivo NPL, Biratnagar Kings, Chitwan Rhinos, Janakpur Bolts, Karnali Yaks, Kathmandu Gurkhas, Lumbini Lions, Pokhara Avengers, Sudurpaschim Royals, TU Cricket Ground, Action Sports HD, NetTV, Dipesh Sapkota"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(nplJsonLd)} />
  </Fragment>

  <SiteHeader activeCategory="npl" />

  <main class="site-shell min-h-screen">
    <div class="mx-auto max-w-7xl px-4 pb-24 pt-8 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-sm text-fg-3">
        <a href="/" class="transition-colors duration-fast ease-out hover:text-fg">Home</a>
        <span aria-hidden="true">/</span>
        <a href="/cricket/" class="transition-colors duration-fast ease-out hover:text-fg">Cricket</a>
        <span aria-hidden="true">/</span>
        <span class="text-fg-2" aria-current="page">NPL 2026</span>
      </nav>

      <NplSchedule client:load />

      <section class="mt-24 border-t border-line pt-16">
        <dl class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-3">
          <div>
            <dt class="eyebrow">Venue</dt>
            <dd class="mt-2 text-base text-fg">TU International Cricket Ground</dd>
            <dd class="mt-2 text-sm leading-6 text-fg-2">
              All <span class="clock">32</span> matches are played at the ground in Kirtipur, Kathmandu.
            </dd>
          </div>
          <div>
            <dt class="eyebrow">Match times</dt>
            <dd class="clock mt-2 text-base text-fg">12:30 PM and 5:00 PM NST</dd>
            <dd class="mt-2 text-sm leading-6 text-fg-2">
              Double-header days have an afternoon game followed by one under lights.
            </dd>
          </div>
          <div>
            <dt class="eyebrow">Where to watch</dt>
            <dd class="mt-2 text-base text-fg">Action Sports HD, NetTV, DishHome</dd>
            <dd class="mt-2 text-sm leading-6 text-fg-2">
              Official broadcasts in Nepal. Sportivo links the authorised streams for each match.
            </dd>
          </div>
        </dl>
      </section>

      <section class="mt-24 border-t border-line pt-16" aria-labelledby="npl-faq-heading">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
          <div class="lg:col-span-4">
            <p class="eyebrow">Questions</p>
            <h2 id="npl-faq-heading" class="mt-3 text-3xl font-medium tracking-[-0.01em] text-fg">About NPL 2026</h2>
          </div>
          <dl class="divide-y divide-line lg:col-span-8">
            {nplFaqs.map((faq) => (
              <div class="py-6 first:pt-0 last:pb-0">
                <dt class="text-base font-medium text-fg">{faq.question}</dt>
                <dd class="mt-2 text-sm leading-6 text-fg-2">{faq.answer}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
</BaseLayout>
