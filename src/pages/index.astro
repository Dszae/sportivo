---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords="Sportivo, sportivo, NPL live match, npl live match, npl live streaming, watch npl live, Nepal Premier League 2026, NPL schedule, live sports fixtures, Nepal Standard Time kickoff, football fixtures, cricket schedules, Dipesh Sapkota, dipeshsapkota7.com.np"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homepageJsonLd)} />
  </Fragment>

  <SiteHeader />

  <main class="site-shell min-h-screen text-slate-100">
    <!-- Full-Width Immersive Hero Showcase -->
    <HeroShowcase client:load />

    <!-- Clean Sports Arenas Directory: 1-Tap Links to Respective Desks -->
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-8 pb-20">
      <div class="mb-10 text-center sm:text-left">
        <span class="rounded-full bg-[#c9f36b]/15 border border-[#c9f36b]/30 px-3 py-1 text-xs font-bold text-[#c9f36b] uppercase tracking-wider">
          Live Sports Desks
        </span>
        <h2 class="mt-3 text-2xl sm:text-3xl font-black text-white tracking-tight">
          Choose Your Sports Arena
        </h2>
        <p class="mt-2 text-sm text-slate-400 max-w-2xl">
          Dedicated portals for live fixture tracking, ball-by-ball score status, and broadcast links synchronized to Nepal Standard Time (NST).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {/* Football Arena Card */}
        <div class="group relative rounded-3xl border border-white/10 bg-[#0e1615] p-6 sm:p-7 shadow-xl hover:border-[#c9f36b]/60 transition-all duration-300 hover:shadow-2xl hover:shadow-[#c9f36b]/10 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl sm:text-4xl">⚽</span>
              <span class="rounded-full bg-[#c9f36b]/15 border border-[#c9f36b]/30 px-2.5 py-0.5 text-[11px] font-black text-[#c9f36b] uppercase">
                European & World
              </span>
            </div>
            <h3 class="text-lg font-black text-white group-hover:text-[#c9f36b] transition-colors">
              Football Desk
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-300">
              Premier League, UEFA Champions League, La Liga, Serie A, and Bundesliga. Real-time scores, lineups, and live stream servers.
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <span class="rounded-md bg-white/5 border border-white/10 px-2 py-0.5 text-[10px] font-bold text-slate-300">Premier League</span>
              <span class="rounded-md bg-white/5 border border-white/10 px-2 py-0.5 text-[10px] font-bold text-slate-300">Champions League</span>
              <span class="rounded-md bg-white/5 border border-white/10 px-2 py-0.5 text-[10px] font-bold text-slate-300">La Liga</span>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10">
            <a
              href="/football/"
              class="inline-flex items-center justify-between w-full rounded-xl bg-[#152320] border border-white/10 px-4 py-2.5 text-xs font-bold text-white group-hover:bg-[#c9f36b] group-hover:text-[#080a0b] group-hover:border-[#c9f36b] transition-all shadow-sm"
            >
              <span>Explore Football Fixtures</span>
              <span class="text-base font-black">&rarr;</span>
            </a>
          </div>
        </div>

        {/* NPL 2026 Arena Card */}
        <div class="group relative rounded-3xl border border-red-500/30 bg-[#160e0f] p-6 sm:p-7 shadow-xl hover:border-red-500 transition-all duration-300 hover:shadow-2xl hover:shadow-red-900/30 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl sm:text-4xl">🇳🇵</span>
              <span class="inline-flex items-center gap-1.5 rounded-full bg-red-600 px-2.5 py-0.5 text-[11px] font-black text-white uppercase animate-pulse">
                <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
                Official 2026
              </span>
            </div>
            <h3 class="text-lg font-black text-white group-hover:text-red-400 transition-colors">
              Nepal Premier League (NPL)
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-300">
              Complete 32-match schedule from TU International Cricket Ground, Kirtipur. Live scores, all 8 franchise teams, and broadcast feeds.
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <span class="rounded-md bg-red-500/10 border border-red-500/20 px-2 py-0.5 text-[10px] font-bold text-red-300">32 Matches</span>
              <span class="rounded-md bg-red-500/10 border border-red-500/20 px-2 py-0.5 text-[10px] font-bold text-red-300">8 Franchises</span>
              <span class="rounded-md bg-red-500/10 border border-red-500/20 px-2 py-0.5 text-[10px] font-bold text-red-300">TU Ground</span>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-red-500/20">
            <a
              href="/npl/"
              class="inline-flex items-center justify-between w-full rounded-xl bg-red-600 px-4 py-2.5 text-xs font-black text-white hover:bg-red-500 transition-all shadow-md"
            >
              <span>Explore NPL 2026 Schedule</span>
              <span class="text-base font-black">&rarr;</span>
            </a>
          </div>
        </div>

        {/* Cricket Arena Card */}
        <div class="group relative rounded-3xl border border-white/10 bg-[#0e1615] p-6 sm:p-7 shadow-xl hover:border-[#c9f36b]/60 transition-all duration-300 hover:shadow-2xl hover:shadow-[#c9f36b]/10 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl sm:text-4xl">🏏</span>
              <span class="rounded-full bg-[#c9f36b]/15 border border-[#c9f36b]/30 px-2.5 py-0.5 text-[11px] font-black text-[#c9f36b] uppercase">
                ICC &amp; IPL
              </span>
            </div>
            <h3 class="text-lg font-black text-white group-hover:text-[#c9f36b] transition-colors">
              Cricket Desk
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-300">
              ICC World Cups, Indian Premier League (IPL), bilateral international series, and Nepal national team fixtures in Nepal Standard Time.
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <span class="rounded-md bg-white/5 border border-white/10 px-2 py-0.5 text-[10px] font-bold text-slate-300">IPL 2026</span>
              <span class="rounded-md bg-white/5 border border-white/10 px-2 py-0.5 text-[10px] font-bold text-slate-300">ICC T20</span>
              <span class="rounded-md bg-white/5 border border-white/10 px-2 py-0.5 text-[10px] font-bold text-slate-300">Nepal Team</span>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10">
            <a
              href="/cricket/"
              class="inline-flex items-center justify-between w-full rounded-xl bg-[#152320] border border-white/10 px-4 py-2.5 text-xs font-bold text-white group-hover:bg-[#c9f36b] group-hover:text-[#080a0b] group-hover:border-[#c9f36b] transition-all shadow-sm"
            >
              <span>Explore Cricket Fixtures</span>
              <span class="text-base font-black">&rarr;</span>
            </a>
          </div>
        </div>

        {/* Basketball Arena Card */}
        <div class="group relative rounded-3xl border border-white/10 bg-[#0e1615] p-6 sm:p-7 shadow-xl hover:border-[#c9f36b]/60 transition-all duration-300 hover:shadow-2xl hover:shadow-[#c9f36b]/10 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl sm:text-4xl">🏀</span>
              <span class="rounded-full bg-amber-400/15 border border-amber-400/30 px-2.5 py-0.5 text-[11px] font-black text-amber-300 uppercase">
                NBA &amp; Europe
              </span>
            </div>
            <h3 class="text-lg font-black text-white group-hover:text-[#c9f36b] transition-colors">
              Basketball Desk
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-300">
              NBA regular season &amp; playoff games, EuroLeague matchups, and live quarter-by-quarter score tracking with verified streams.
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
              <span class="rounded-md bg-white/5 border border-white/10 px-2 py-0.5 text-[10px] font-bold text-slate-300">NBA League</span>
              <span class="rounded-md bg-white/5 border border-white/10 px-2 py-0.5 text-[10px] font-bold text-slate-300">EuroLeague</span>
              <span class="rounded-md bg-white/5 border border-white/10 px-2 py-0.5 text-[10px] font-bold text-slate-300">Live Quarters</span>
            </div>
          </div>
          <div class="mt-6 pt-4 border-t border-white/10">
            <a
              href="/basketball/"
              class="inline-flex items-center justify-between w-full rounded-xl bg-[#152320] border border-white/10 px-4 py-2.5 text-xs font-bold text-white group-hover:bg-[#c9f36b] group-hover:text-[#080a0b] group-hover:border-[#c9f36b] transition-all shadow-sm"
            >
              <span>Explore Basketball Games</span>
              <span class="text-base font-black">&rarr;</span>
            </a>
          </div>
        </div>

        {/* Personal Watchlist Card */}
        <div class="group relative rounded-3xl border border-amber-400/30 bg-[#16140e] p-6 sm:p-7 shadow-xl hover:border-amber-400 transition-all duration-300 hover:shadow-2xl hover:shadow-amber-900/20 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl sm:text-4xl">⭐</span>
              <span class="rounded-full bg-amber-400/15 border border-amber-400/30 px-2.5 py-0.5 text-[11px] font-black text-amber-300 uppercase">
                Personalized
              </span>
            </div>
            <h3 class="text-lg font-black text-white group-hover:text-amber-300 transition-colors">
              My Watchlist &amp; Alerts
            </h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-300">
              Star your favorite teams and matches. Receive 5-minute pre-match kickoff notifications in your browser or phone. No login required.
            </p>
            <div class="mt-4 flex flex-wrap gap-1.5">
