---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MatchExplorer from '../components/MatchExplorer';
import HeroShowcase, { type HeroMatch } from '../components/HeroShowcase';
import { categories, fetchMatches, getMatchTimestamp, slugify, statusOf, titleOf, type Match } from '../lib/sportivo';

const data = await Promise.all(
  categories.map(async (category) => {
    try {
      return [category, await fetchMatches(category)] as const;
    } catch {
      return [category, [] as Match[]] as const;
    }
  })
);
const byCategory = Object.fromEntries(data) as Record<string, Match[]>;

// Hero preview: live matches first, then the next kickoffs, across all sports.
const kathmanduDay = (ts: number) =>
  new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Kathmandu', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(ts));
const today = kathmanduDay(Date.now());
const heroTime = (ts: number) =>
  new Intl.DateTimeFormat('en-US', {
    timeZone: 'Asia/Kathmandu',
    ...(kathmanduDay(ts) === today ? {} : { month: 'short', day: 'numeric' }),
    hour: 'numeric',
    minute: '2-digit',
    hour12: true,
  }).format(new Date(ts));

const heroMatches: HeroMatch[] = data
  .flatMap(([category, matches]) => matches.map((m) => ({ category, m })))
  .map(({ category, m }) => ({ category, m, status: statusOf(m), ts: getMatchTimestamp(m) ?? Number.MAX_SAFE_INTEGER }))
  .filter((x) => x.status !== 'Final' && x.ts !== Number.MAX_SAFE_INTEGER)
  .sort((a, b) => (a.status === 'Live') === (b.status === 'Live') ? a.ts - b.ts : a.status === 'Live' ? -1 : 1)
  .slice(0, 5)
  .map(({ category, m, status, ts }) => ({
    href: `/${category}/match/${encodeURIComponent(slugify(titleOf(m)))}/`,
    title: titleOf(m),
    category,
    time: heroTime(ts),
    live: status === 'Live',
  }));

const title = 'Sportivo — NPL Live Match, Cricket Scores & Sports Streaming Nepal (NST)';
const description = 'Watch NPL live match streaming online, follow real-time Nepal Premier League 2026 cricket scores, football fixtures, and basketball schedules in Nepal Standard Time (NST) on Sportivo by Dipesh Sapkota.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/';

const faqs = [
  {
    question: 'What is Sportivo?',
    answer: 'Sportivo is an independent live sports schedule and scores desk created by Dipesh Sapkota. It aggregates football, cricket, and basketball matches from verified sports feeds and automatically converts kickoff timestamps into Nepal Standard Time (NST / UTC+5:45).',
  },
  {
    question: 'How are kickoff times converted to Nepal Standard Time (NST)?',
    answer: 'Sportivo processes fixture timestamps from upstream providers and automatically converts them to Asia/Kathmandu time (UTC+5:45). Fans across Nepal can see exact local start times for Premier League, Champions League, IPL, and NBA games without doing manual timezone math.',
  },
  {
    question: 'Which sports and tournaments are covered on Sportivo?',
    answer: 'Sportivo provides fixture schedules, real-time scores, and stream availability for Football (Premier League, UEFA Champions League, La Liga, Serie A, Bundesliga, MLS), Cricket (ICC World Cup, bilateral series, IPL), and Basketball (NBA, EuroLeague).',
  },
  {
    question: 'How do I save favorite teams and matches on Sportivo?',
    answer: 'Star any fixture or open the Watchlist page. Saved teams and starred matches are stored in your browser, with no account needed.',
  },
  {
    question: 'Who created and maintains Sportivo?',
    answer: 'Sportivo was designed, developed, and published by Dipesh Sapkota, a software developer and engineering student from Nepal.',
  },
];

