---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FotmobHub from '../components/FotmobHub';

const title = 'Sportivo — NPL Live Match, Cricket Scores & Sports Streaming Nepal (NST)';
const description = 'Watch NPL live match streaming online, follow real-time Nepal Premier League 2026 cricket scores, football fixtures, and basketball schedules in Nepal Standard Time (NST) on Sportivo by Dipesh Sapkota.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/';

const faqs = [
  {
    question: 'What is Sportivo?',
    answer: 'Sportivo is an independent live sports schedule and scores desk created by Dipesh Sapkota. It aggregates football, cricket, and basketball matches from verified sports feeds and automatically converts kickoff timestamps into Nepal Standard Time (NST / UTC+5:45).',
  },
  {
    question: 'How are kickoff times converted to Nepal Standard Time (NST)?',
    answer: 'Sportivo processes fixture timestamps from upstream providers and automatically converts them to Asia/Kathmandu time (UTC+5:45). Fans across Nepal can see exact local start times for Premier League, Champions League, IPL, and NBA games without doing manual timezone math.',
  },
  {
    question: 'Which sports and tournaments are covered on Sportivo?',
    answer: 'Sportivo provides fixture schedules, real-time scores, and stream availability for Football (Premier League, UEFA Champions League, La Liga, Serie A, Bundesliga, MLS), Cricket (ICC World Cup, bilateral series, IPL), and Basketball (NBA, EuroLeague).',
  },
  {
    question: 'How do I save favorite teams and matches on Sportivo?',
    answer: 'Tap the ☆ star on any fixture card or visit the "My Watchlist" dashboard. Your saved teams and starred matches are synchronized locally in your browser without requiring account creation.',
  },
  {
    question: 'Who created and maintains Sportivo?',
    answer: 'Sportivo was designed, developed, and published by Dipesh Sapkota, a software developer and engineering student from Nepal.',
  },
];

const homepageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'SportsOrganization',
      '@id': `${canonical}#organization`,
      'name': 'Sportivo',
      'url': canonical,
      'logo': {
        '@type': 'ImageObject',
        '@id': `${canonical}#logo`,
        'url': 'https://sportivo.dipeshsapkota7.com.np/favicon.svg',
        'contentUrl': 'https://sportivo.dipeshsapkota7.com.np/favicon.svg',
        'caption': 'Sportivo Official Logo',
        'creditText': 'Sportivo by Dipesh Sapkota',
        'creator': {
          '@type': 'Person',
          '@id': 'https://www.dipeshsapkota7.com.np/#person',
          'name': 'Dipesh Sapkota',
          'url': 'https://www.dipeshsapkota7.com.np/'
        },
        'copyrightNotice': 'Copyright 2026 Sportivo',
        'license': canonical,
        'acquireLicensePage': canonical
      },
      'description': description,
      'founder': {
        '@id': 'https://www.dipeshsapkota7.com.np/#person'
      },
      'sameAs': [
        'https://github.com/dszae',
        'https://linkedin.com/in/dszae',
        'https://facebook.com/dsz.ae'
      ],
      'knowsAbout': [
        'Sportivo',
        'NPL Live Match',
        'Nepal Premier League 2026',
        'Football Fixtures & Live Streams',
        'Cricket Schedules & Scores',
        'Basketball & NBA Fixtures',
        'Nepal Standard Time (NST)',
        'Live Sports Streaming'
      ]
    },
    {
      '@type': 'ImageObject',
      '@id': `${canonical}#primary-image`,
      'url': 'https://sportivo.dipeshsapkota7.com.np/sportivo-preview.png',
      'contentUrl': 'https://sportivo.dipeshsapkota7.com.np/sportivo-preview.png',
      'name': 'Sportivo Sports Fixture Desk Preview',
      'caption': 'Sportivo live sports scores, kickoff schedules, and streams in Nepal Standard Time (NST)',
      'creditText': 'Dipesh Sapkota',
      'creator': {
        '@type': 'Person',
        '@id': 'https://www.dipeshsapkota7.com.np/#person',
        'name': 'Dipesh Sapkota',
        'url': 'https://www.dipeshsapkota7.com.np/'
