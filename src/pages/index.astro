      },
      'image': {
        '@type': 'ImageObject',
        '@id': 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/#profile-image',
        'url': 'https://sportivo.dipeshsapkota7.com.np/dipesh-sapkota-profile.webp',
        'contentUrl': 'https://sportivo.dipeshsapkota7.com.np/dipesh-sapkota-profile.webp',
        'name': 'Dipesh Sapkota Profile Photo',
        'caption': 'Dipesh Sapkota, engineering student, software developer, and the creator and publisher of Sportivo',
        'creditText': 'Dipesh Sapkota',
        'creator': {
          '@type': 'Person',
          '@id': 'https://www.dipeshsapkota7.com.np/#person',
          'name': 'Dipesh Sapkota',
          'url': 'https://www.dipeshsapkota7.com.np/'
        },
        'copyrightNotice': 'Copyright 2026 Dipesh Sapkota',
        'license': 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/',
        'acquireLicensePage': 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/'
      },
      'sameAs': [
        'https://www.dipeshsapkota7.com.np/',
        'https://github.com/dszae',
        'https://linkedin.com/in/dszae',
        'https://facebook.com/dsz.ae'
      ]
    },
    {
      '@type': 'WebApplication',
      '@id': `${canonical}#app`,
      'url': canonical,
      'name': 'Sportivo',
      'applicationCategory': 'SportsApplication',
      'operatingSystem': 'All',
      'description': description,
      'browserRequirements': 'Requires JavaScript. Requires HTML5.',
      'offers': {
        '@type': 'Offer',
        'price': '0',
        'priceCurrency': 'USD'
      },
      'author': {
        '@id': 'https://www.dipeshsapkota7.com.np/#person'
      },
      'creator': {
        '@id': 'https://www.dipeshsapkota7.com.np/#person'
      }
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonical}#breadcrumb`,
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Home',
          'item': canonical
        }
      ]
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#sitelinks`,
      'name': 'Sportivo Primary Sitelinks',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'Football Fixtures',
          'item': {
            '@type': 'WebPage',
            '@id': 'https://sportivo.dipeshsapkota7.com.np/football/#webpage',
            'url': 'https://sportivo.dipeshsapkota7.com.np/football/',
            'name': 'Football Fixtures',
            'description': 'Live football match scores, NST kickoff times, and streaming servers'
          }
        },
        {
          '@type': 'ListItem',
          'position': 2,
          'name': 'Cricket Fixtures',
          'item': {
