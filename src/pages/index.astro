---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords="Sportivo, live sports fixtures, Nepal Standard Time kickoff, football fixtures, cricket schedules, basketball scores, Nepal sports streaming"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homepageJsonLd)} />
  </Fragment>

  <SiteHeader />

  <main class="site-shell min-h-screen text-slate-100">
    <!-- Hero Section -->
    <section class="mx-auto max-w-7xl px-6 pb-10 pt-12 sm:pt-16">
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <a
          href="/about-dipesh-sapkota/"
          class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-300 hover:border-[#c9f36b]/40 hover:text-[#c9f36b] transition-all shadow-sm"
          title="Learn more about the creator of Sportivo"
        >
          <img
            src="/dipesh-sapkota-profile.webp"
            alt="Creator profile"
            class="h-4 w-4 rounded-full object-cover border border-[#c9f36b]"
            width="16"
            height="16"
            loading="eager"
          />
          <span>Sportivo by Dipesh Sapkota</span>
        </a>
        <span class="text-xs font-bold text-[#e5b94f]">Live Fixture Desk · Nepal</span>
      </div>

      <h1 class="max-w-3xl text-4xl font-black leading-[0.98] tracking-tight text-white sm:text-6xl">
        Sportivo — Stay close to every <span class="text-[#c9f36b]">kickoff.</span>
      </h1>
      
      <p class="mt-5 max-w-2xl text-sm leading-7 text-slate-400 sm:text-base">
        Sportivo aggregates live football, cricket, and basketball schedules in Nepal Standard Time (NST) with reliable streaming options and real-time match updates.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3 text-xs font-bold">
        <a
          class="inline-flex items-center gap-1.5 rounded-full bg-[#c9f36b] px-4 py-2 text-[#0a1110] hover:bg-[#b8e25d] transition-all shadow-md shadow-[#c9f36b]/20 font-black"
          href="/dashboard/"
        >
          <span aria-hidden="true">★</span>
          <span>My Watchlist</span>
        </a>
        <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-slate-300">
          Football, Cricket & Basketball
        </span>
        <a
          class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-slate-300 hover:border-[#c9f36b]/40 hover:text-[#c9f36b] transition-all"
          href="/about-dipesh-sapkota/"
        >
          About the Creator &rarr;
        </a>
        <a
          class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-slate-400 hover:text-white transition-all"
          href="/api-docs/"
        >
          Developer API
        </a>
      </div>
    </section>

    <!-- Fixture Explorers -->
    <section class="mx-auto max-w-7xl space-y-16 px-6 pb-20" aria-label="Sports fixtures categories">
      {categories.map((category) => (
        <MatchExplorer
          client:load
          category={category}
          matches={byCategory[category] || []}
          exploreUrl={`/${category}/`}
        />
      ))}
    </section>

    <!-- Why Sportivo: SEO Authority & Feature Highlights -->
    <section class="border-t border-white/5 bg-[#0a0f0e]/60 py-20">
      <div class="mx-auto max-w-7xl px-6">
        <div class="max-w-3xl">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#e5b94f]">Nepal Sports Desk</p>
          <h2 class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">
            Why Sports Fans in Nepal Rely on Sportivo
          </h2>
          <p class="mt-4 text-sm leading-7 text-slate-300 sm:text-base">
            Never miss a kickoff because of international timezone confusion. Sportivo is engineered to bring accurate schedules, live scores, and verified broadcast links into one unified experience.
          </p>
        </div>

        <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
          <div class="rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-md transition-all hover:border-[#c9f36b]/40">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#c9f36b]/10 text-[#c9f36b]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </span>
            <h3 class="mt-4 text-base font-bold text-white">Nepal Standard Time (NST)</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-400">
              Timestamps are automatically converted into UTC+5:45. See exact local match start times without manual calculations.
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-md transition-all hover:border-[#c9f36b]/40">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#c9f36b]/10 text-[#c9f36b]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="23 7 16 12 23 17 23 7"></polygon>
                <rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect>
              </svg>
            </span>
            <h3 class="mt-4 text-base font-bold text-white">Multi-Server Streams</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-400">
              Dynamically aggregates live stream fallbacks from multiple upstream providers so you always have a working broadcast feed.
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-md transition-all hover:border-[#c9f36b]/40">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#c9f36b]/10 text-[#c9f36b]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
              </svg>
            </span>
            <h3 class="mt-4 text-base font-bold text-white">Personal Watchlist</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-400">
              Star your must-watch games to build a custom feed, filter by date, and track your teams across football, cricket, and basketball.
            </p>
          </div>

          <div class="rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-md transition-all hover:border-[#c9f36b]/40">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#c9f36b]/10 text-[#c9f36b]">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
              </svg>
            </span>
            <h3 class="mt-4 text-base font-bold text-white">Live Status &amp; Scores</h3>
            <p class="mt-2 text-xs leading-relaxed text-slate-400">
              Live indicators show which games are broadcasting right now, which are upcoming, and which fixtures have ended.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Homepage Frequently Asked Questions (FAQ) Section -->
    <section class="border-t border-white/5 py-20" aria-labelledby="homepage-faq-heading">
      <div class="mx-auto max-w-4xl px-6">
        <div class="text-center">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#e5b94f]">Information &amp; Guidance</p>
          <h2 id="homepage-faq-heading" class="mt-2 text-3xl font-black tracking-tight text-white sm:text-4xl">
            Frequently Asked Questions
          </h2>
          <p class="mt-3 text-sm text-slate-300">
            Everything you need to know about Sportivo fixtures, kickoff times, and stream tracking in Nepal.
          </p>
        </div>

        <div class="mt-10 space-y-4">
          {faqs.map((faq) => (
            <div class="rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-sm">
              <h3 class="text-base font-bold text-white">{faq.question}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-300">{faq.answer}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>