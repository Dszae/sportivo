      '@id': `${canonical}#sitelinks`,
      'name': 'Sportivo Primary Sitelinks',
      'itemListElement': [
        {
          '@type': 'ListItem',
          'position': 1,
          'name': 'NPL 2026 Live Match & Schedule',
