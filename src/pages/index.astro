---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MatchExplorer from '../components/MatchExplorer';
import { categories, fetchMatches, type Match } from '../lib/sportivo';

const data = await Promise.all(
  categories.map(async (category) => {
    try {
      return [category, await fetchMatches(category)] as const;
    } catch {
      return [category, [] as Match[]] as const;
    }
  })
);
const byCategory = Object.fromEntries(data) as Record<string, Match[]>;

const title = 'Sportivo — Live Football, Cricket & Basketball Scores & Streams Nepal';
const description = 'Sportivo is Nepal\'s live sports fixture desk for football, cricket, and basketball schedules in Nepal Standard Time (NST) with real-time stream links and scores.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/';

const homepageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${canonical}#website`,
      'url': canonical,
      'name': 'Sportivo',
      'alternateName': [
        'Sportivo Live Desk',
        'Sportivo Sports Fixture Desk',
        'Sportivo Nepal'
      ],
      'description': description,
      'inLanguage': 'en-NP',
      'publisher': {
        '@type': 'Person',
        '@id': 'https://www.dipeshsapkota7.com.np/#person',
        'name': 'Dipesh Sapkota',
        'url': 'https://www.dipeshsapkota7.com.np/',
        'image': 'https://sportivo.dipeshsapkota7.com.np/dipesh-sapkota-profile.webp',
        'sameAs': [
          'https://www.dipeshsapkota7.com.np/',
          'https://github.com/dszae',
          'https://linkedin.com/in/dszae',
          'https://facebook.com/dsz.ae'
        ]
      },
      'author': {
        '@id': 'https://www.dipeshsapkota7.com.np/#person'
      },
      'potentialAction': {
        '@type': 'SearchAction',
        'target': 'https://sportivo.dipeshsapkota7.com.np/?q={search_term_string}',
        'query-input': 'required name=search_term_string'
      },
      'hasPart': [
        {
          '@type': 'WebPage',
          '@id': 'https://sportivo.dipeshsapkota7.com.np/football/#webpage',
          'url': 'https://sportivo.dipeshsapkota7.com.np/football/',
          'name': 'Football Fixtures',
          'description': 'Live football scores, matches, schedules, and stream links in Nepal Standard Time.'
        },
        {
          '@type': 'WebPage',
          '@id': 'https://sportivo.dipeshsapkota7.com.np/cricket/#webpage',
          'url': 'https://sportivo.dipeshsapkota7.com.np/cricket/',
          'name': 'Cricket Fixtures',
          'description': 'Live cricket schedules, upcoming tournaments, and stream availability.'
        },
        {
          '@type': 'WebPage',
          '@id': 'https://sportivo.dipeshsapkota7.com.np/basketball/#webpage',
          'url': 'https://sportivo.dipeshsapkota7.com.np/basketball/',
          'name': 'Basketball Fixtures',
          'description': 'Live basketball matches, NBA fixtures, and streaming server options.'
        },
        {
          '@type': 'WebPage',
          '@id': 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/#webpage',
          'url': 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/',
          'name': 'About the Creator',
          'description': 'Official profile and biography of the creator and publisher of Sportivo.'
        },
        {
          '@type': 'WebPage',
          '@id': 'https://sportivo.dipeshsapkota7.com.np/api-docs/#webpage',
          'url': 'https://sportivo.dipeshsapkota7.com.np/api-docs/',
          'name': 'Developer API',
          'description': 'Public fixture endpoints documentation for developers.'
        }
      ]
    },
    {
      '@type': 'Person',
      '@id': 'https://www.dipeshsapkota7.com.np/#person',
      'name': 'Dipesh Sapkota',
      'alternateName': ['Dipesh', 'dszae'],
      'url': 'https://www.dipeshsapkota7.com.np/',
      'jobTitle': 'Software Developer & Engineering Student',
      'description': 'Dipesh Sapkota is an engineering student, software developer, and the creator and publisher of Sportivo from Nepal.',
      'nationality': {
        '@type': 'Country',
        'name': 'Nepal'
      },
      'image': 'https://sportivo.dipeshsapkota7.com.np/dipesh-sapkota-profile.webp',
      'sameAs': [
        'https://www.dipeshsapkota7.com.np/',
        'https://github.com/dszae',
        'https://linkedin.com/in/dszae',
        'https://facebook.com/dsz.ae'
      ]
    },
    {
      '@type': 'ItemList',
      '@id': `${canonical}#sitelinks`,
      'name': 'Sportivo Primary Sitelinks',
      'itemListElement': [
        {
          '@type': 'SiteNavigationElement',
          'position': 1,
          'name': 'Football Fixtures',
          'description': 'Live football match scores, NST kickoff times, and streaming servers',
          'url': 'https://sportivo.dipeshsapkota7.com.np/football/'
        },
        {
          '@type': 'SiteNavigationElement',
          'position': 2,
          'name': 'Cricket Fixtures',
          'description': 'Cricket match schedules and streaming availability in Nepal time',
          'url': 'https://sportivo.dipeshsapkota7.com.np/cricket/'
        },
        {
          '@type': 'SiteNavigationElement',
          'position': 3,
          'name': 'Basketball Fixtures',
          'description': 'Basketball game schedules, scores, and broadcast feeds',
          'url': 'https://sportivo.dipeshsapkota7.com.np/basketball/'
        },
        {
          '@type': 'SiteNavigationElement',
          'position': 4,
          'name': 'About the Creator',
          'description': 'Official profile and biography of the creator and publisher of Sportivo',
          'url': 'https://sportivo.dipeshsapkota7.com.np/about-dipesh-sapkota/'
        },
        {
          '@type': 'SiteNavigationElement',
          'position': 5,
          'name': 'Developer API',
          'description': 'Sportivo public fixture API documentation',
          'url': 'https://sportivo.dipeshsapkota7.com.np/api-docs/'
        }
      ]
    }
  ]
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords="Sportivo, live sports fixtures, Nepal Standard Time kickoff, football fixtures, cricket schedules, basketball scores, Nepal sports streaming"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homepageJsonLd)} />
  </Fragment>

  <SiteHeader />

  <main class="site-shell min-h-screen text-slate-100">
    <!-- Hero Section -->
    <section class="mx-auto max-w-7xl px-6 pb-10 pt-12 sm:pt-16">
      <div class="mb-5 flex flex-wrap items-center gap-3">
        <a
          href="/about-dipesh-sapkota/"
          class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs font-semibold text-slate-300 hover:border-[#c9f36b]/40 hover:text-[#c9f36b] transition-all shadow-sm"
          title="Learn more about the creator of Sportivo"
        >
          <img
            src="/dipesh-sapkota-profile.webp"
            alt="Creator profile"
            class="h-4 w-4 rounded-full object-cover border border-[#c9f36b]"
            width="16"
            height="16"
            loading="eager"
          />
          <span>Sportivo by Dipesh Sapkota</span>
        </a>
        <span class="text-[10px] font-black uppercase tracking-[0.25em] text-[#e5b94f]">Live Fixture Desk · Nepal</span>
      </div>

      <h1 class="max-w-3xl text-4xl font-black leading-[0.98] tracking-tight text-white sm:text-6xl">
        Sportivo — Stay close to every <span class="text-[#c9f36b]">kickoff.</span>
      </h1>
      
      <p class="mt-5 max-w-2xl text-sm leading-7 text-slate-400 sm:text-base">
        Sportivo aggregates live football, cricket, and basketball schedules in Nepal Standard Time (NST) with multi-server stream fallbacks and real-time provider updates.
      </p>

      <div class="mt-8 flex flex-wrap items-center gap-3 text-xs font-bold">
        <span class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-slate-300">
          Football, Cricket & Basketball
        </span>
        <a
          class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-slate-300 hover:border-[#c9f36b]/40 hover:text-[#c9f36b] transition-all"
          href="/about-dipesh-sapkota/"
        >
          About the Creator &rarr;
        </a>
        <a
          class="rounded-full border border-white/10 bg-white/5 px-4 py-2 text-slate-400 hover:text-white transition-all"
          href="/api-docs/"
        >
          Developer API
        </a>
      </div>
    </section>

    <!-- Fixture Explorers -->
    <section class="mx-auto max-w-7xl space-y-14 px-6 pb-20" aria-label="Sports fixtures categories">
      {categories.map((category) => (
        <div>
          <div class="mb-4 flex items-baseline justify-between gap-4">
            <h2 class="text-2xl font-black text-white capitalize">
              {category}
            </h2>
            <a class="text-xs font-bold text-[#c9f36b] hover:text-white transition" href={`/${category}/`}>
              Explore {category} &rarr;
            </a>
          </div>
          <MatchExplorer client:load category={category} matches={byCategory[category] || []} />
        </div>
      ))}
    </section>
  </main>

  <SiteFooter />
</BaseLayout>