---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PersonalDashboard from '../../components/PersonalDashboard';
import { categories, fetchMatches, type Category, type Match } from '../../lib/sportivo';

const data = await Promise.all(
  categories.map(async (category: Category) => {
    try {
      return [category, await fetchMatches(category)] as const;
    } catch {
      return [category, [] as Match[]] as const;
    }
  })
);
const byCategory = Object.fromEntries(data) as Record<string, Match[]>;

const title = 'My Watchlist — Custom Sports Schedule & Live Desk | Sportivo';
const description = 'Access your saved matches and personalized sports schedule on Sportivo. Track live broadcast feeds, star upcoming kickoffs, and monitor matches in Nepal time.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/dashboard/';

const dashboardJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonical}#webpage`,
  'url': canonical,
  'name': 'My Watchlist & Personal Sports Desk',
  'description': description,
  'isPartOf': {
    '@type': 'WebSite',
    '@id': 'https://sportivo.dipeshsapkota7.com.np/#website',
    'name': 'Sportivo',
    'url': 'https://sportivo.dipeshsapkota7.com.np/'
  },
  'breadcrumb': {
    '@type': 'BreadcrumbList',
    'itemListElement': [
      {
        '@type': 'ListItem',
        'position': 1,
        'name': 'Home',
        'item': 'https://sportivo.dipeshsapkota7.com.np/'
      },
      {
        '@type': 'ListItem',
        'position': 2,
        'name': 'My Watchlist',
        'item': canonical
      }
    ]
  }
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(dashboardJsonLd)} />
  </Fragment>

  <SiteHeader activeCategory="dashboard" />

  <main class="site-shell min-h-screen text-slate-100">
    <section class="mx-auto max-w-7xl px-6 pb-20 pt-12 sm:pt-16">
      <nav aria-label="Breadcrumb" class="mb-8 text-xs text-slate-500">
        <a href="/" class="hover:text-[#c9f36b] transition">Sportivo</a>
        <span class="mx-2">/</span>
        <span class="text-slate-300">My Watchlist</span>
      </nav>

      <div class="mb-10 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <p class="text-xs font-bold uppercase tracking-widest text-[#e5b94f]">Sportivo User Workspace</p>
          <h1 class="text-4xl font-black tracking-tight text-white sm:text-6xl mt-1">
            My Watchlist
          </h1>
          <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-400">
            Select your preferred sports, follow favorite clubs and tournaments, star important matches, and view automatic kickoff times in your local timezone.
          </p>
        </div>
        <div class="flex items-center gap-2">
          <a
            href="/"
            class="inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-bold text-slate-300 hover:border-[#c9f36b]/40 hover:text-[#c9f36b] transition"
          >
            <span>&larr; Back to Main Desk</span>
          </a>
        </div>
      </div>

      <PersonalDashboard client:load allMatchesByCategory={byCategory} />
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
