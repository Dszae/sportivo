---
export const prerender = true;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';

const title = 'Sportivo Public Fixture API Documentation';
const description = 'Official public sports fixture API documentation for Sportivo. Access real-time football, cricket, and basketball fixture endpoints.';
const canonical = 'https://sportivo.dipeshsapkota7.com.np/api-docs/';

const apiJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${canonical}#article`,
      'url': canonical,
      'headline': 'Sportivo Public Fixture API Documentation',
      'description': description,
      'author': {
        '@type': 'Person',
        '@id': 'https://www.dipeshsapkota7.com.np/#person',
        'name': 'Dipesh Sapkota',
        'url': 'https://www.dipeshsapkota7.com.np/'
      },
      'publisher': {
        '@type': 'WebSite',
        '@id': 'https://sportivo.dipeshsapkota7.com.np/#website',
        'name': 'Sportivo'
      },
      'breadcrumb': {
        '@type': 'BreadcrumbList',
        'itemListElement': [
          {
            '@type': 'ListItem',
            'position': 1,
            'name': 'Sportivo',
            'item': 'https://sportivo.dipeshsapkota7.com.np/'
          },
          {
            '@type': 'ListItem',
            'position': 2,
            'name': 'API Documentation',
            'item': canonical
          }
        ]
      }
    }
  ]
};
---
<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  keywords="Sportivo API, sports fixture API, football API, cricket API, basketball API, developer documentation"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(apiJsonLd)} />
  </Fragment>

  <SiteHeader activeCategory="api-docs" />

  <main class="site-shell min-h-screen">
    <article class="mx-auto max-w-3xl px-4 pb-24 pt-8 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="flex items-center gap-2 text-sm text-fg-3">
        <a href="/" class="transition-colors duration-fast ease-out hover:text-fg">Home</a>
        <span aria-hidden="true">/</span>
        <span class="text-fg-2" aria-current="page">Developer API</span>
      </nav>

      <p class="eyebrow clock mt-10">REST, v1.0</p>
      <h1 class="mt-3 text-4xl font-medium tracking-[-0.02em] text-fg sm:text-5xl">Fixture API</h1>
      <p class="mt-6 text-base leading-7 text-fg-2">
        Read-only JSON endpoints for the fixtures shown on Sportivo, for dashboards, widgets and schedule trackers. Data is refreshed from upstream providers on each request.
      </p>

      <h2 class="mt-16 text-2xl font-medium text-fg">Endpoints</h2>
      <ul class="mt-4 divide-y divide-line text-sm">
        <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:gap-6"><code class="clock shrink-0 text-fg">GET /api/matches/football</code><span class="text-fg-2">Live and scheduled football matches</span></li>
        <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:gap-6"><code class="clock shrink-0 text-fg">GET /api/matches/cricket</code><span class="text-fg-2">Cricket fixtures and statuses</span></li>
        <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:gap-6"><code class="clock shrink-0 text-fg">GET /api/matches/basketball</code><span class="text-fg-2">Basketball fixtures</span></li>
      </ul>

      <h2 class="mt-16 text-2xl font-medium text-fg">Response</h2>
      <p class="mt-4 text-base leading-7 text-fg-2">A JSON array. Each fixture may include:</p>
      <pre class="clock mt-4 overflow-x-auto rounded-xl border border-line bg-ink-800 p-4 text-xs leading-5 text-fg-2"><code>{`[
  {
    "id": "match-uuid",
    "title": "Arsenal vs Chelsea",
    "category": "football",
    "status": "live",
    "date": 1728900000000,
    "teams": { "home": { "name": "Arsenal" }, "away": { "name": "Chelsea" } },
    "sources": [{ "source": "alpha", "id": "stream1" }]
  }
]`}</code></pre>

      <div class="mt-16 border-t border-line pt-8">
        <h3 class="text-base font-medium text-fg">Source</h3>
        <p class="mt-2 text-sm leading-6 text-fg-2">
          The project is open on <a href="https://github.com/dszae" target="_blank" rel="noopener noreferrer" class="text-fg underline underline-offset-4">GitHub</a>, by <a href="/about-dipesh-sapkota/" class="text-fg underline underline-offset-4">Dipesh Sapkota</a>.
        </p>
      </div>
    </article>
  </main>

  <SiteFooter />
</BaseLayout>