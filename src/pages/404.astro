---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---
<BaseLayout
  title="Page not found | Sportivo by Dipesh Sapkota"
  description="The requested Sportivo page was not found."
  canonical="https://sportivo.dipeshsapkota7.com.np/404/"
  noindex={true}
>
  <SiteHeader />
  <main class="site-shell min-h-screen">
    <section class="mx-auto max-w-3xl px-6 py-32">
      <p class="eyebrow clock">404</p>
      <h1 class="mt-3 text-4xl font-medium tracking-[-0.02em] text-fg sm:text-5xl">Page not found</h1>
      <p class="mt-4 text-base text-fg-2">That fixture or page does not exist, or has moved.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">Fixtures</a>
        <a href="/npl/" class="btn btn-secondary">NPL 2026</a>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>