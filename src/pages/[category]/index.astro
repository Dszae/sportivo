---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MatchExplorer from '../../components/MatchExplorer';
import NplSchedule from '../../components/NplSchedule';
import { fetchMatches, isCategory, type Category, type Match } from '../../lib/sportivo';

const categoryParam = Astro.params.category || '';
const validCategory = isCategory(categoryParam);
if (!validCategory) {
  Astro.response.status = 404;
} else {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=30, stale-while-revalidate=60');
}

const category = (validCategory ? categoryParam : 'football') as Category;
let matches: Match[] = [];
let unavailable = false;

try {
  matches = await fetchMatches(category);
} catch {
  unavailable = true;
}

const label = category[0].toUpperCase() + category.slice(1);
const canonical = `https://sportivo.dipeshsapkota7.com.np/${category}/`;

const titles: Record<Category, string> = {
  football: 'Football Fixtures, Live Scores & Streams Nepal (NST) - Sportivo',
  cricket: 'Cricket Schedules, Live Scores & Fixtures Nepal (NST) - Sportivo',
  basketball: 'Basketball & NBA Schedules, Live Scores Nepal (NST) - Sportivo',
};

const descriptions: Record<Category, string> = {
  football: 'Browse live football matches, Premier League, UEFA Champions League, and La Liga schedules in Nepal Standard Time (NST) with multi-server stream options.',
  cricket: 'Track live cricket scores, ICC events, IPL schedules, and bilateral tournament fixtures in Nepal Standard Time (NST) on Sportivo.',
  basketball: 'Follow NBA games, EuroLeague schedules, live basketball scores, and verified broadcast feeds in Nepal Standard Time (NST) on Sportivo.',
};

const categoryFaqs: Record<Category, Array<{ question: string; answer: string }>> = {
  football: [
    {
      question: 'What time are football matches broadcast in Nepal?',
      answer: 'All football kickoff times on Sportivo are converted in real time to Nepal Standard Time (NST / UTC+5:45). Premier League evening matches typically start between 6:00 PM and 1:30 AM NST.',
    },
    {
      question: 'Which football leagues can I track on Sportivo?',
      answer: 'Sportivo covers the Premier League, UEFA Champions League, La Liga, Serie A, Bundesliga, MLS, and major international tournaments.',
    },
    {
      question: 'How does Sportivo ensure working football streams?',
      answer: 'Sportivo aggregates multiple fallback stream servers for scheduled matches so fans have reliable broadcast options without dead links.',
    },
  ],
  cricket: [
    {
      question: 'Are cricket match schedules shown in Nepal Standard Time (NST)?',
      answer: 'Yes, every cricket fixture — including ICC World Cup, Asia Cup, IPL, and bilateral series — is calibrated to Asia/Kathmandu time (UTC+5:45).',
    },
    {
      question: 'Does Sportivo provide live cricket scores and status?',
      answer: 'Sportivo displays live match indicators, upcoming kickoff countdowns, and real-time provider stream availability for ongoing matches.',
    },
    {
      question: 'Can I follow Nepal national cricket team matches on Sportivo?',
      answer: 'Yes, international cricket fixtures featuring Nepal and ICC Associate nations are tracked alongside full-member matches.',
    },
  ],
  basketball: [
    {
      question: 'When do NBA games start in Nepal time?',
      answer: 'NBA games played in North America typically start between 4:30 AM and 8:30 AM Nepal Standard Time (NST). Sportivo displays exact local start times.',
    },
    {
      question: 'Which basketball tournaments are available on Sportivo?',
      answer: 'Sportivo tracks NBA regular season and playoffs, EuroLeague, FIBA tournaments, and NCAA college basketball fixtures.',
    },
    {
      question: 'Can I filter basketball fixtures by date?',
      answer: 'Yes, use the date filter tabs to easily view games for Today, Tomorrow, or the Next 7 Days.',
    },
  ],
};

const title = validCategory ? titles[category] : 'Page not found - Sportivo';
const description = validCategory ? descriptions[category] : 'The requested Sportivo page was not found.';
const faqs = validCategory ? categoryFaqs[category] : [];

const categoryJsonLd = validCategory
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'CollectionPage',
          '@id': `${canonical}#webpage`,
          'url': canonical,
          'name': title,
          'description': description,
          'isPartOf': {
            '@type': 'WebSite',
            '@id': 'https://sportivo.dipeshsapkota7.com.np/#website',
            'url': 'https://sportivo.dipeshsapkota7.com.np/',
            'name': 'Sportivo',
            'publisher': {
              '@id': 'https://www.dipeshsapkota7.com.np/#person'
            }
          },
          'author': {
            '@type': 'Person',
            '@id': 'https://www.dipeshsapkota7.com.np/#person',
            'name': 'Dipesh Sapkota',
            'url': 'https://www.dipeshsapkota7.com.np/'
          },
          'breadcrumb': {
            '@type': 'BreadcrumbList',
            'itemListElement': [
              {
                '@type': 'ListItem',
                'position': 1,
                'name': 'Sportivo',
                'item': 'https://sportivo.dipeshsapkota7.com.np/'
              },
              {
                '@type': 'ListItem',
                'position': 2,
                'name': `${label} Fixtures`,
                'item': canonical
              }
            ]
          }
        },
        {
          '@type': 'FAQPage',
          '@id': `${canonical}#faq`,
          'mainEntity': faqs.map((faq) => ({
            '@type': 'Question',
            'name': faq.question,
            'acceptedAnswer': {
              '@type': 'Answer',
              'text': faq.answer
            }
          }))
        }
      ]
    }
  : null;
---
<BaseLayout
  title={title}
  description={description}
  canonical={validCategory ? canonical : 'https://sportivo.dipeshsapkota7.com.np/404/'}
  noindex={!validCategory}
  keywords={`${category} fixtures, live ${category} Nepal, ${category} streaming, NST ${category} kickoff, Sportivo, Dipesh Sapkota`}
>
  {categoryJsonLd && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(categoryJsonLd)} />
    </Fragment>
  )}

  <SiteHeader activeCategory={validCategory ? category : undefined} />

  <main class="site-shell min-h-screen">
    <section class="mx-auto max-w-7xl px-4 pb-24 pt-8 sm:px-6 lg:px-8">
      {validCategory ? (
        <>
          <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-sm text-fg-3">
            <a href="/" class="transition-colors duration-fast ease-out hover:text-fg">Home</a>
            <span aria-hidden="true">/</span>
            <span class="text-fg-2" aria-current="page">{label}</span>
          </nav>

          <div class="mb-10 max-w-2xl">
            <p class="eyebrow">Fixtures and streams</p>
            <h1 class="mt-3 text-4xl font-medium tracking-[-0.02em] text-fg sm:text-5xl">{label}</h1>
            <p class="mt-4 text-base leading-7 text-fg-2">
              {category === 'basketball' && 'NBA, EuroLeague and FIBA games with tip-off times in Nepal Standard Time, live scores and the stream servers available for each one.'}
              {category === 'football' && 'Premier League, Champions League, La Liga, Serie A, Bundesliga and MLS fixtures with kickoffs in Nepal Standard Time, live scores and stream servers.'}
              {category === 'cricket' && 'ICC tournaments, the IPL, bilateral series and Nepal national team matches in Nepal Standard Time, with live scores and stream servers.'}
            </p>
          </div>

          {unavailable && (
            <p class="mb-8 rounded-xl border border-line bg-ink-800 px-4 py-3 text-sm text-fg-2" role="status">
              Fixtures are temporarily unavailable. The upstream provider did not return a usable response.
            </p>
          )}

          {category === 'cricket' && (
            <div class="mb-20">
              <NplSchedule client:load />
            </div>
          )}

          <MatchExplorer client:load category={category} matches={matches} />

          <section class="mt-24 border-t border-line pt-16" aria-labelledby="category-faq-heading">
            <div class="grid grid-cols-1 gap-12 lg:grid-cols-12">
              <div class="lg:col-span-4">
                <p class="eyebrow">Questions</p>
                <h2 id="category-faq-heading" class="mt-3 text-3xl font-medium tracking-[-0.01em] text-fg">
                  {label} in Nepal time
                </h2>
              </div>
              <dl class="divide-y divide-line lg:col-span-8">
                {faqs.map((faq) => (
                  <div class="py-6 first:pt-0 last:pb-0">
                    <dt class="text-base font-medium text-fg">{faq.question}</dt>
                    <dd class="mt-2 text-sm leading-6 text-fg-2">{faq.answer}</dd>
                  </div>
                ))}
              </dl>
            </div>
          </section>
        </>
      ) : (
        <div class="py-24">
          <p class="eyebrow clock">404</p>
          <h1 class="mt-3 text-4xl font-medium tracking-[-0.02em] text-fg">Page not found</h1>
          <p class="mt-4 text-base text-fg-2">There is no sport at this address.</p>
          <a href="/" class="btn btn-primary mt-8">Fixtures</a>
        </div>
      )}
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
