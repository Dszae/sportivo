---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import MatchExplorer from '../../components/MatchExplorer';
import { fetchMatches, isCategory, type Category, type Match } from '../../lib/sportivo';

const categoryParam = Astro.params.category || '';
const validCategory = isCategory(categoryParam);
if (!validCategory) {
  Astro.response.status = 404;
}

const category = (validCategory ? categoryParam : 'football') as Category;
let matches: Match[] = [];
let unavailable = false;

try {
  matches = await fetchMatches(category);
} catch {
  unavailable = true;
}

const label = category[0].toUpperCase() + category.slice(1);
const canonical = `https://sportivo.dipeshsapkota7.com.np/${category}/`;

const titles: Record<Category, string> = {
  football: 'Football Fixtures, Live Scores & Streams Nepal (NST) - Sportivo',
  cricket: 'Cricket Schedules, Live Scores & Fixtures Nepal (NST) - Sportivo',
  basketball: 'Basketball & NBA Schedules, Live Scores Nepal (NST) - Sportivo',
};

const descriptions: Record<Category, string> = {
  football: 'Browse live football matches, Premier League, UEFA Champions League, and La Liga schedules in Nepal Standard Time (NST) with multi-server stream options.',
  cricket: 'Track live cricket scores, ICC events, IPL schedules, and bilateral tournament fixtures in Nepal Standard Time (NST) on Sportivo.',
  basketball: 'Follow NBA games, EuroLeague schedules, live basketball scores, and verified broadcast feeds in Nepal Standard Time (NST) on Sportivo.',
};

const categoryFaqs: Record<Category, Array<{ question: string; answer: string }>> = {
  football: [
    {
      question: 'What time are football matches broadcast in Nepal?',
      answer: 'All football kickoff times on Sportivo are converted in real time to Nepal Standard Time (NST / UTC+5:45). Premier League evening matches typically start between 6:00 PM and 1:30 AM NST.',
    },
    {
      question: 'Which football leagues can I track on Sportivo?',
      answer: 'Sportivo covers the Premier League, UEFA Champions League, La Liga, Serie A, Bundesliga, MLS, and major international tournaments.',
    },
    {
      question: 'How does Sportivo ensure working football streams?',
      answer: 'Sportivo aggregates multiple fallback stream servers for scheduled matches so fans have reliable broadcast options without dead links.',
    },
  ],
  cricket: [
    {
      question: 'Are cricket match schedules shown in Nepal Standard Time (NST)?',
      answer: 'Yes, every cricket fixture — including ICC World Cup, Asia Cup, IPL, and bilateral series — is calibrated to Asia/Kathmandu time (UTC+5:45).',
    },
    {
      question: 'Does Sportivo provide live cricket scores and status?',
      answer: 'Sportivo displays live match indicators, upcoming kickoff countdowns, and real-time provider stream availability for ongoing matches.',
    },
    {
      question: 'Can I follow Nepal national cricket team matches on Sportivo?',
      answer: 'Yes, international cricket fixtures featuring Nepal and ICC Associate nations are tracked alongside full-member matches.',
    },
  ],
  basketball: [
    {
      question: 'When do NBA games start in Nepal time?',
      answer: 'NBA games played in North America typically start between 4:30 AM and 8:30 AM Nepal Standard Time (NST). Sportivo displays exact local start times.',
    },
    {
      question: 'Which basketball tournaments are available on Sportivo?',
      answer: 'Sportivo tracks NBA regular season and playoffs, EuroLeague, FIBA tournaments, and NCAA college basketball fixtures.',
    },
    {
      question: 'Can I filter basketball fixtures by date?',
      answer: 'Yes, use the date filter tabs to easily view games for Today, Tomorrow, or the Next 7 Days.',
    },
  ],
};

const title = validCategory ? titles[category] : 'Page not found - Sportivo';
const description = validCategory ? descriptions[category] : 'The requested Sportivo page was not found.';
const faqs = validCategory ? categoryFaqs[category] : [];

const categoryJsonLd = validCategory
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'CollectionPage',
          '@id': `${canonical}#webpage`,
          'url': canonical,
          'name': title,
          'description': description,
          'isPartOf': {
            '@type': 'WebSite',
            '@id': 'https://sportivo.dipeshsapkota7.com.np/#website',
            'url': 'https://sportivo.dipeshsapkota7.com.np/',
            'name': 'Sportivo',
            'publisher': {
              '@id': 'https://www.dipeshsapkota7.com.np/#person'
            }
          },
          'author': {
            '@type': 'Person',
            '@id': 'https://www.dipeshsapkota7.com.np/#person',
            'name': 'Dipesh Sapkota',
            'url': 'https://www.dipeshsapkota7.com.np/'
          },
          'breadcrumb': {
            '@type': 'BreadcrumbList',
            'itemListElement': [
              {
                '@type': 'ListItem',
                'position': 1,
                'name': 'Sportivo',
                'item': 'https://sportivo.dipeshsapkota7.com.np/'
              },
              {
                '@type': 'ListItem',
                'position': 2,
                'name': `${label} Fixtures`,
                'item': canonical
              }
            ]
          }
        },
        {
          '@type': 'FAQPage',
          '@id': `${canonical}#faq`,
          'mainEntity': faqs.map((faq) => ({
            '@type': 'Question',
            'name': faq.question,
            'acceptedAnswer': {
              '@type': 'Answer',
              'text': faq.answer
            }
          }))
        }
      ]
    }
  : null;
---
<BaseLayout
  title={title}
  description={description}
  canonical={validCategory ? canonical : 'https://sportivo.dipeshsapkota7.com.np/404/'}
  noindex={!validCategory}
  keywords={`${category} fixtures, live ${category} Nepal, ${category} streaming, NST ${category} kickoff, Sportivo, Dipesh Sapkota`}
>
  {categoryJsonLd && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(categoryJsonLd)} />
    </Fragment>
  )}

  <SiteHeader activeCategory={validCategory ? category : undefined} />

  <main class="site-shell min-h-screen text-slate-100">
    <section class="mx-auto max-w-7xl px-6 pb-20 pt-12 sm:pt-16">
      {validCategory ? (
        <>
          <nav aria-label="Breadcrumb" class="mb-8 text-xs text-slate-500">
            <a href="/" class="hover:text-[#c9f36b] transition">Sportivo</a>
            <span class="mx-2">/</span>
            <span class="text-slate-300">{label}</span>
          </nav>

          <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-[#e5b94f]">Sportivo Sports Desk</p>
              <h1 class="text-4xl font-black tracking-tight text-white sm:text-6xl mt-1">
                {label} Fixtures &amp; Streams
              </h1>
              <p class="mt-3 max-w-2xl text-sm leading-7 text-slate-400">
                Live coverage, upcoming matches, scores, and kickoff times with verified multi-source streams.
              </p>
            </div>
            <a
              href="/about-dipesh-sapkota/"
              class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-bold text-slate-300 hover:border-[#c9f36b]/40 hover:text-[#c9f36b] transition shrink-0"
            >
              <span>About the Creator</span>
              <span>&rarr;</span>
            </a>
          </div>

          <div class="mb-8 rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-sm">
            <h2 class="text-base font-bold text-white mb-2">{label} Schedule &amp; Broadcast Desk (NST)</h2>
            <p class="text-xs leading-relaxed text-slate-300">
              {category === 'basketball' && 'Sportivo tracks NBA regular season games, playoffs, EuroLeague, and FIBA tournaments. All game tip-offs are synchronized directly to Nepal Standard Time (UTC+5:45), helping fans across Nepal follow early morning games with verified multi-source stream fallbacks.'}
              {category === 'football' && 'Sportivo aggregates match fixtures across the Premier League, UEFA Champions League, La Liga, Serie A, and Bundesliga. Kickoffs are calibrated to Nepal Standard Time (UTC+5:45) with multi-provider broadcast signals.'}
              {category === 'cricket' && 'Sportivo provides comprehensive cricket schedules for ICC tournaments, the Indian Premier League (IPL), bilateral international series, and Nepal national team matches in Nepal Standard Time (UTC+5:45).'}
            </p>
          </div>

          {unavailable && (
            <p class="mt-6 rounded-xl border border-red-400/20 bg-red-400/10 px-4 py-3 text-sm text-red-200" role="status">
              Fixtures are temporarily unavailable. The upstream provider did not return a usable response.
            </p>
          )}

          <div class="mt-10">
            <MatchExplorer client:load category={category} matches={matches} />
          </div>

          <!-- Category Specific FAQs for SEO Rich Snippets -->
          <section class="mt-20 border-t border-white/5 pt-16" aria-labelledby="category-faq-heading">
            <div class="max-w-3xl">
              <p class="text-xs font-bold uppercase tracking-[0.2em] text-[#e5b94f]">Information &amp; Guidance</p>
              <h2 id="category-faq-heading" class="mt-2 text-2xl font-black tracking-tight text-white sm:text-3xl">
                {label} Fixtures FAQ
              </h2>
              <p class="mt-2 text-sm text-slate-300">
                Common questions about {label} kickoff times in Nepal Standard Time (NST) and live stream coverage on Sportivo.
              </p>
            </div>

            <div class="mt-8 space-y-4">
              {faqs.map((faq) => (
                <div class="rounded-2xl border border-white/10 bg-[#111a19] p-6 shadow-sm">
                  <h3 class="text-base font-bold text-white">{faq.question}</h3>
                  <p class="mt-2 text-sm leading-relaxed text-slate-300">{faq.answer}</p>
                </div>
              ))}
            </div>
          </section>
        </>
      ) : (
        <div class="py-16">
          <p class="text-xs font-bold uppercase tracking-widest text-[#e5b94f]">404</p>
          <h1 class="mt-4 text-4xl font-black text-white">Page not found</h1>
          <p class="mt-4 text-slate-400">The requested Sportivo category does not exist.</p>
          <a href="/" class="mt-8 inline-block font-bold text-[#c9f36b]">Return to Sportivo Home</a>
        </div>
      )}
    </section>
  </main>

  <SiteFooter />
</BaseLayout>