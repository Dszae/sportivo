---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MatchPlayer from '../../../components/MatchPlayer';
import {
  fetchMatches,
  isCategory,
  slugify,
  titleOf,
  statusOf,
  timeOf,
  type Category,
  type Match,
} from '../../../lib/sportivo';

const categoryParam = Astro.params.category || '';
const slug = Astro.params.slug || '';
const validCategory = isCategory(categoryParam);
const category = (validCategory ? categoryParam : 'football') as Category;

let match: Match | undefined;
let relatedMatches: Match[] = [];
if (validCategory) {
  try {
    const list = await fetchMatches(category);
    match = list.find((item) => slugify(titleOf(item)) === slug);
    relatedMatches = list.filter((item) => slugify(titleOf(item)) !== slug).slice(0, 4);
  } catch {
    match = undefined;
  }
}

if (!validCategory || !match) {
  Astro.response.status = 404;
}

const title = match ? titleOf(match) : 'Fixture not found';
const categoryLabel = category[0].toUpperCase() + category.slice(1);
const pageTitle = match
  ? `${title} - ${categoryLabel} Live Stream & NST Fixture | Sportivo`
  : 'Fixture not found | Sportivo';
const pageDescription = match
  ? `Watch ${title} live stream online. ${categoryLabel} fixture status: ${statusOf(match)}, kickoff at ${timeOf(match)} Nepal Standard Time on Sportivo.`
  : 'The requested Sportivo fixture was not found.';
const canonical = `https://sportivo.dipeshsapkota7.com.np/${category}/match/${encodeURIComponent(slug)}/`;

const matchJsonLd = match
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'SportsEvent',
          '@id': `${canonical}#event`,
          'name': title,
          'sport': category,
          'description': pageDescription,
          'url': canonical,
          'eventStatus': statusOf(match) === 'Live' ? 'https://schema.org/EventScheduled' : 'https://schema.org/EventScheduled',
          'organizer': {
            '@type': 'Person',
            '@id': 'https://www.dipeshsapkota7.com.np/#person',
            'name': 'Dipesh Sapkota',
            'url': 'https://www.dipeshsapkota7.com.np/'
          },
          'location': {
            '@type': 'VirtualLocation',
            'url': canonical
          }
        },
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          'itemListElement': [
            {
              '@type': 'ListItem',
              'position': 1,
              'name': 'Sportivo',
              'item': 'https://sportivo.dipeshsapkota7.com.np/'
            },
            {
              '@type': 'ListItem',
              'position': 2,
              'name': `${categoryLabel} Fixtures`,
              'item': `https://sportivo.dipeshsapkota7.com.np/${category}/`
            },
            {
              '@type': 'ListItem',
              'position': 3,
              'name': title,
              'item': canonical
            }
          ]
        }
      ]
    }
  : null;
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  keywords={`${title}, ${category} fixture, live ${category} stream, Sportivo by Dipesh Sapkota, Nepal sports`}
>
  {matchJsonLd && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(matchJsonLd)} />
    </Fragment>
  )}

  <SiteHeader activeCategory={category} />

  <main class="site-shell min-h-screen text-slate-100">
    <section class="mx-auto max-w-7xl px-6 pb-20 pt-10">
      <nav aria-label="Breadcrumb" class="mb-8 text-xs text-slate-500">
        <a href="/" class="hover:text-[#c9f36b] transition">Sportivo</a>
        <span class="mx-2">/</span>
        <a href={`/${category}/`} class="hover:text-[#c9f36b] capitalize transition">{category} fixtures</a>
        <span class="mx-2">/</span>
        <span class="text-slate-300">{title}</span>
      </nav>

      {match ? (
        <>
          <div class="mb-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
            <h1 class="text-3xl font-black text-white sm:text-5xl">{title}</h1>
            <a
              href="/about-dipesh-sapkota/"
              class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/5 px-3.5 py-1.5 text-xs font-bold text-slate-300 hover:text-[#c9f36b] transition shrink-0"
            >
              <span>By Dipesh Sapkota</span>
            </a>
          </div>

          <div class="mb-8 grid gap-3 text-sm text-slate-300 sm:grid-cols-3">
            <p class="rounded-lg border border-white/10 bg-[#111a19] px-4 py-3">
              <strong class="text-white">Status:</strong> {statusOf(match)}
            </p>
            <p class="rounded-lg border border-white/10 bg-[#111a19] px-4 py-3">
              <strong class="text-white">Kickoff:</strong> {timeOf(match)}
            </p>
            <p class="rounded-lg border border-white/10 bg-[#111a19] px-4 py-3">
              <strong class="text-white">Sport category:</strong> {match.category || category}
            </p>
          </div>

          <MatchPlayer client:load match={match} />

          {relatedMatches.length > 0 && (
            <div class="mt-14 border-t border-white/5 pt-10">
              <div class="mb-6 flex items-center justify-between">
                <div>
                  <span class="text-[10px] font-black uppercase tracking-widest text-[#e5b94f]">More {categoryLabel}</span>
                  <h3 class="text-xl font-black text-white mt-0.5">Upcoming Matches</h3>
                </div>
                <a href={`/${category}/`} class="text-xs font-bold text-[#c9f36b] hover:underline">
                  View all {category} &rarr;
                </a>
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {relatedMatches.map((relMatch) => {
                  const relTitle = titleOf(relMatch);
                  const relSlug = slugify(relTitle);
                  const relStatus = statusOf(relMatch);
                  const relTime = timeOf(relMatch);
                  return (
                    <a
                      href={`/${category}/match/${encodeURIComponent(relSlug)}/`}
                      class="group rounded-2xl border border-white/10 bg-[#111a19] p-4 shadow-lg hover:-translate-y-1 hover:border-[#e5b94f]/50 transition"
                    >
                      <div class="flex items-center justify-between text-[10px] font-bold text-slate-400">
                        <span class={relStatus === 'Live' ? 'font-black text-red-400' : ''}>
                          {relStatus === 'Live' ? '● LIVE' : relStatus}
                        </span>
                        <span>{relTime}</span>
                      </div>
                      <h4 class="mt-2 text-sm font-bold text-white group-hover:text-[#e5b94f] line-clamp-2">
                        {relTitle}
                      </h4>
                      <span class="mt-3 inline-block text-[10px] font-bold text-[#c9f36b]">
                        Match Center &amp; Stream &rarr;
                      </span>
                    </a>
                  );
                })}
              </div>
            </div>
          )}
        </>
      ) : (
        <div class="rounded-xl border border-white/10 bg-[#111a19] p-8">
          <h1 class="text-3xl font-black text-white">Fixture not found</h1>
          <p class="mt-3 text-slate-400">This Sportivo match URL does not identify an active public fixture.</p>
          <a href={`/${category}/`} class="mt-6 inline-block font-bold text-[#c9f36b]">
            Return to {category} fixtures &rarr;
          </a>
        </div>
      )}
    </section>
  </main>

  <SiteFooter />
</BaseLayout>