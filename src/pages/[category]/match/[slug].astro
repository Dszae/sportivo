---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import MatchPlayer from '../../../components/MatchPlayer';
import { getCalibratedNplFixtures } from '../../../lib/data/nplData';
import { fetchUnifiedMatches, resolveUnifiedPlayback } from '../../../lib/providers';
import {
  detectFootballLeague,
  getMatchTimestamp,
  isCategory,
  slugify,
  titleOf,
  statusOf,
  timeOf,
  type Category,
  type Match,
} from '../../../lib/sportivo';

function teamParts(rawTitle: string) {
  const parts = rawTitle.split(/\s+vs\.?\s+|\s+-\s+/i);
  return { home: parts[0]?.trim() || rawTitle, away: parts[1]?.trim() || '' };
}

const categoryParam = Astro.params.category || '';
const slug = Astro.params.slug || '';
const validCategory = isCategory(categoryParam);
const category = (validCategory ? categoryParam : 'football') as Category;

let match: Match | undefined;
let relatedMatches: Match[] = [];
if (validCategory) {
  try {
    const list = await fetchUnifiedMatches(category);
    match = list.find((item) => slugify(titleOf(item)) === slug || item.id === slug);

    // If not found in real-time feeds, check verified tournament databases (e.g. NPL)
    if (!match && category === 'cricket') {
      const now = Date.now();
      const calibratedFixtures = getCalibratedNplFixtures(now);
      const nplMatch = calibratedFixtures.find((m) => {
        const s1 = slugify(`${m.homeTeam} vs ${m.awayTeam}`);
        const s2 = slugify(`${m.awayTeam} vs ${m.homeTeam}`);
        return (
          s1 === slug ||
          s2 === slug ||
          m.id.toLowerCase() === slug.toLowerCase() ||
          slugify(m.id) === slug
        );
      });

      if (nplMatch) {
        const hasConcludedSummary = Boolean(nplMatch.summary && /won by|tied|no result|abandoned|defeated/i.test(nplMatch.summary));
        const isPast = nplMatch.status === 'COMPLETED' || hasConcludedSummary || now > nplMatch.timestamp + 3.25 * 3600 * 1000;
        const isMatchWindow =
          !isPast &&
          (nplMatch.status === 'LIVE' ||
            (now >= nplMatch.timestamp - 15 * 60 * 1000 && now <= nplMatch.timestamp + 3.25 * 3600 * 1000));
        const nplStatus = isPast ? 'Final' : isMatchWindow ? 'Live' : 'Upcoming';

        match = {
          id: nplMatch.id,
          title: `${nplMatch.homeTeam} vs ${nplMatch.awayTeam}`,
          category: 'cricket',
          competition: nplMatch.competition || 'Nepal Premier League',
          league: 'NPL',
          status: nplStatus,
          date: nplMatch.timestamp,
          teams: {
            home: { name: nplMatch.homeTeam, badge: nplMatch.homeTeamLogo },
            away: { name: nplMatch.awayTeam, badge: nplMatch.awayTeamLogo },
          },
          poster: nplMatch.homeTeamLogo || 'https://nepalpremierleague.org/icon.svg',
          score: {
            home: nplMatch.homeScore,
            away: nplMatch.awayScore,
          },
          summary: nplMatch.summary,
          sources:
            nplStatus === 'Final'
              ? []
              : [
                  {
                    source: 'npl',
                    id: nplMatch.id,
                    label: nplMatch.broadcast?.provider || 'Action Sports HD (TU Ground Direct Feed)',
                  },
                ],
        };
      }
    }

    if (match) {
      relatedMatches = list.filter((item) => slugify(titleOf(item)) !== slug).slice(0, 4);
      if (relatedMatches.length === 0 && category === 'cricket') {
        const now = Date.now();
        relatedMatches = getCalibratedNplFixtures(now)
          .filter((m) => m.id !== match?.id)
          .slice(0, 4)
          .map((m) => {
            const isPast = m.status === 'COMPLETED' || now > m.timestamp + 3.75 * 3600 * 1000;
            const isMatchWindow =
              !isPast &&
              (m.status === 'LIVE' ||
                (now >= m.timestamp - 15 * 60 * 1000 && now <= m.timestamp + 3.75 * 3600 * 1000));
            const relStatus = isPast ? 'Final' : isMatchWindow ? 'Live' : 'Upcoming';

            return {
              id: m.id,
              title: `${m.homeTeam} vs ${m.awayTeam}`,
              category: 'cricket' as Category,
              competition: 'Nepal Premier League',
              league: 'NPL',
              status: relStatus,
              date: m.timestamp,
              teams: {
                home: { name: m.homeTeam, badge: m.homeTeamLogo },
                away: { name: m.awayTeam, badge: m.awayTeamLogo },
              },
              poster: m.homeTeamLogo,
              sources:
                relStatus === 'Final'
                  ? []
                  : [
                      {
                        source: 'npl',
                        id: m.id,
                        label: m.broadcast?.provider || 'NetTV Action Sports HD / FanCode',
                      },
                    ],
            };
          });
      }
    }
  } catch {
    match = undefined;
  }
}

if (!validCategory || !match) {
  Astro.response.status = 404;
}

// Server-Side Stream Resolution (SSR Backend):
// Resolves streams on the backend server before HTML delivery so no client-side API calls are exposed to the user.
let initialStreams: any[] = [];
if (match?.sources && match.sources.length > 0 && statusOf(match) !== 'Final') {
  const primarySource = match.sources[0];
  if (primarySource?.source && primarySource?.id) {
    try {
      const resolution = await resolveUnifiedPlayback(primarySource.source, primarySource.id);
      if (resolution.status === 'ready' && resolution.streams.length > 0) {
        initialStreams = resolution.streams;
      }
    } catch {}
  }
}

const title = match ? titleOf(match) : 'Fixture not found';
const categoryLabel = category[0].toUpperCase() + category.slice(1);
const pageTitle = match
  ? `${title} - ${categoryLabel} Live Stream & Score | Nepal Time | Sportivo`
  : 'Fixture not found | Sportivo';
const pageDescription = match
  ? `Watch ${title} live broadcast online. ${categoryLabel} match status: ${statusOf(match)}, kickoff at ${timeOf(match)} Nepal Standard Time (NST) on Sportivo.`
  : 'The requested Sportivo fixture was not found.';
const canonical = `https://sportivo.dipeshsapkota7.com.np/${category}/match/${encodeURIComponent(slug)}/`;

const matchTs = match ? getMatchTimestamp(match) : null;
const startDateIso = matchTs ? new Date(matchTs).toISOString() : undefined;
const endDateIso = matchTs ? new Date(matchTs + 2.5 * 3600 * 1000).toISOString() : undefined;
const { home, away } = teamParts(title);
const eventStatusUrl = match && statusOf(match) === 'Live'
  ? 'https://schema.org/EventLive'
  : match && statusOf(match) === 'Final'
  ? 'https://schema.org/EventPostponed'
  : 'https://schema.org/EventScheduled';

const matchJsonLd = match
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'SportsEvent',
          '@id': `${canonical}#event`,
          'name': title,
          'sport': category,
          'description': pageDescription,
          'url': canonical,
          ...(startDateIso ? { 'startDate': startDateIso } : {}),
          ...(endDateIso ? { 'endDate': endDateIso } : {}),
          'eventStatus': eventStatusUrl,
          ...(home ? { 'homeTeam': { '@type': 'SportsTeam', 'name': home } } : {}),
          ...(away ? { 'awayTeam': { '@type': 'SportsTeam', 'name': away } } : {}),
          'competitor': [
            ...(home ? [{ '@type': 'SportsTeam', 'name': home }] : []),
            ...(away ? [{ '@type': 'SportsTeam', 'name': away }] : [])
          ],
          'organizer': {
            '@type': 'Person',
            '@id': 'https://www.dipeshsapkota7.com.np/#person',
            'name': 'Dipesh Sapkota',
            'url': 'https://www.dipeshsapkota7.com.np/'
          },
          'location': {
            '@type': 'VirtualLocation',
            'url': canonical
          },
          'offers': {
            '@type': 'Offer',
            'url': canonical,
            'price': '0',
            'priceCurrency': 'USD',
            'availability': 'https://schema.org/InStock'
          }
        },
        {
          '@type': 'BreadcrumbList',
          '@id': `${canonical}#breadcrumb`,
          'itemListElement': [
            {
              '@type': 'ListItem',
              'position': 1,
              'name': 'Sportivo',
              'item': 'https://sportivo.dipeshsapkota7.com.np/'
            },
            {
              '@type': 'ListItem',
              'position': 2,
              'name': `${categoryLabel} Fixtures`,
              'item': `https://sportivo.dipeshsapkota7.com.np/${category}/`
            },
            {
              '@type': 'ListItem',
              'position': 3,
              'name': title,
              'item': canonical
            }
          ]
        }
      ]
    }
  : null;
---
<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonical}
  noindex={!validCategory || !match}
  keywords={`${title}, ${category} fixture, live ${category} stream, Sportivo by Dipesh Sapkota, Nepal sports`}
>
  {matchJsonLd && (
    <Fragment slot="head">
      <script type="application/ld+json" set:html={JSON.stringify(matchJsonLd)} />
    </Fragment>
  )}

  <SiteHeader activeCategory={category} />

  <main class="site-shell min-h-screen">
    <section class="mx-auto max-w-7xl px-4 pb-24 pt-8 sm:px-6 lg:px-8">
      <nav aria-label="Breadcrumb" class="mb-8 flex items-center gap-2 text-sm text-fg-3">
        <a href="/" class="transition-colors duration-fast ease-out hover:text-fg">Home</a>
        <span aria-hidden="true">/</span>
        <a href={`/${category}/`} class="capitalize transition-colors duration-fast ease-out hover:text-fg">{category}</a>
        <span aria-hidden="true">/</span>
        <span class="truncate text-fg-2" aria-current="page">{title}</span>
      </nav>

      {match ? (
        <>
          <div class="mb-8 flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
            <div class="min-w-0">
              <p class="eyebrow">{match.category === 'football' ? detectFootballLeague(match) : categoryLabel}</p>
              <h1 class="mt-3 text-3xl font-medium tracking-[-0.02em] text-fg sm:text-5xl">{title}</h1>
            </div>
            <div class="flex shrink-0 items-center gap-4 text-sm">
              {statusOf(match) === 'Live' ? (
                <span class="live-tag text-sm"><span class="live-dot"></span>Live</span>
              ) : (
                <span class="text-fg-2">{statusOf(match)}</span>
              )}
              <span class="clock text-fg">{timeOf(match)} NST</span>
            </div>
          </div>

          <MatchPlayer
            client:load
            match={match}
            initialStreams={initialStreams}
            showNplHub={Boolean(category === 'cricket' && (match.league === 'NPL' || match.competition?.toLowerCase().includes('nepal premier league') || match.sources?.some((s) => s.source === 'npl')))}
          />

          <div class="mt-16 grid grid-cols-1 gap-12 lg:grid-cols-12">
            <div class="lg:col-span-8">
              <h2 class="text-xl font-medium text-fg">About this match</h2>
              <p class="mt-3 text-sm leading-6 text-fg-2">
                {title} is a {categoryLabel.toLowerCase()} fixture starting at <span class="clock text-fg">{timeOf(match)} NST</span>.
                Streams open around 15 minutes before the start. If a server buffers, switch to another one in the player above.
              </p>
              <dl class="mt-6 grid grid-cols-2 gap-6 border-t border-line pt-6 text-sm sm:grid-cols-3">
                <div>
                  <dt class="meta">Competition</dt>
                  <dd class="mt-1 text-fg">{match.category === 'football' ? detectFootballLeague(match) : categoryLabel}</dd>
                </div>
                <div>
                  <dt class="meta">Kickoff</dt>
                  <dd class="clock mt-1 text-fg">{timeOf(match)} NST</dd>
                </div>
                <div>
                  <dt class="meta">Servers</dt>
                  <dd class="clock mt-1 text-fg">{match.sources?.length ?? 0}</dd>
                </div>
              </dl>
            </div>

            <div class="lg:col-span-4">
              <h3 class="text-sm font-medium text-fg">From the player</h3>
              <ul class="mt-3 space-y-2 text-sm text-fg-2">
                <li>Add to Google Calendar or download an .ics file</li>
                <li>Star the match to get an alert before it starts</li>
                <li>Switch servers if one drops</li>
              </ul>
              <a href="/dashboard/" class="btn btn-secondary btn-sm mt-5">Watchlist</a>
            </div>
          </div>

          {relatedMatches.length > 0 && (
            <div class="mt-24 border-t border-line pt-16">
              <div class="mb-6 flex items-center justify-between">
                <h3 class="text-xl font-medium text-fg">More {category}</h3>
                <a href={`/${category}/`} class="btn btn-ghost btn-sm">
                  All {category}
                  <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
                </a>
              </div>

              <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                {relatedMatches.map((relMatch) => {
                  const relTitle = titleOf(relMatch);
                  const relSlug = slugify(relTitle);
                  const relStatus = statusOf(relMatch);
                  const relTime = timeOf(relMatch);
                  return (
                    <a
                      href={`/${category}/match/${encodeURIComponent(relSlug)}/`}
                      class="card flex flex-col p-4 transition-colors duration-fast ease-out hover:border-line-strong"
                    >
                      <div class="flex items-center justify-between">
                        {relStatus === 'Live' ? (
                          <span class="live-tag"><span class="live-dot"></span>Live</span>
                        ) : (
                          <span class="meta">{relStatus}</span>
                        )}
                        <span class="clock text-xs text-fg-2">{relTime}</span>
                      </div>
                      <h4 class="mt-3 line-clamp-2 text-sm text-fg">{relTitle}</h4>
                    </a>
                  );
                })}
              </div>
            </div>
          )}
        </>
      ) : (
        <div class="card p-8">
          <h1 class="text-3xl font-medium text-fg">Fixture not found</h1>
          <p class="mt-3 text-sm text-fg-2">This match is not in the current schedule.</p>
          <a href={`/${category}/`} class="btn btn-secondary mt-6 capitalize">{category} fixtures</a>
        </div>
      )}
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
